---
/**
 * Botón oficial "Download on the App Store".
 *
 * El `href` va siempre a /app y nunca directo a apps.apple.com: esa página
 * añade el parámetro `ct` que App Store Connect usa para atribuir la
 * instalación a un canal. Enlazar directo tira ese dato a la basura.
 *
 * `from` identifica el sitio del botón dentro de la web, así se puede ver
 * cuál de los tres convierte.
 *
 * El badge va en SVG en línea, no como imagen: escala sin pesar, hereda el
 * foco del teclado y no añade una petición más al cargar.
 */
interface Props {
  from: string;
  lang?: "en" | "es" | "it";
  size?: "md" | "lg";
  class?: string;
}
const { from, lang = "en", size = "md", class: extra = "" } = Astro.props;
const h = size === "lg" ? 60 : 50;

// Apple distribuye el badge traducido y pide usar el del idioma de la página.
// La segunda línea es "App Store" en los tres: es marca, no se traduce.
const LABEL = {
  en: { small: "Download on the", aria: "Download Dear Wander on the App Store" },
  es: { small: "Consíguelo en el", aria: "Consigue Dear Wander en el App Store" },
  it: { small: "Scaricalo su",     aria: "Scarica Dear Wander sull'App Store" },
} as const;
const label = LABEL[lang] ?? LABEL.en;
---

<a
  href={`/app?from=${from}`}
  class={`asb ${extra}`}
  style={`height:${h}px`}
  aria-label={label.aria}
>
  <svg class="asb-apple" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M17.05 12.53c-.02-2.2 1.8-3.26 1.88-3.31-1.02-1.5-2.62-1.7-3.19-1.72-1.36-.14-2.65.8-3.34.8-.69 0-1.75-.78-2.87-.76-1.48.02-2.84.86-3.6 2.18-1.53 2.66-.39 6.6 1.1 8.76.73 1.06 1.6 2.25 2.74 2.2 1.1-.04 1.51-.71 2.84-.71 1.32 0 1.7.71 2.86.69 1.18-.02 1.93-1.08 2.65-2.14.84-1.23 1.18-2.42 1.2-2.48-.03-.01-2.29-.88-2.31-3.5zM14.86 5.6c.6-.74 1.01-1.76.9-2.78-.87.04-1.93.58-2.56 1.31-.56.65-1.06 1.69-.93 2.68.97.08 1.97-.49 2.59-1.21z"
    />
  </svg>
  <span class="asb-text">
    <span class="asb-small">{label.small}</span>
    <span class="asb-large">App Store</span>
  </span>
</a>

<style>
  .asb {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    padding: 0 1.1em 0 0.95em;
    border-radius: 0.55em;
    background: #000;
    color: #fff;
    text-decoration: none;
    /* El badge de Apple usa su tipografía de sistema, no la del sitio. */
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    line-height: 1;
    /* La caja no debe encogerse dentro de un flex padre. */
    flex: 0 0 auto;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
    box-shadow: 0 10px 30px -12px rgba(0, 0, 0, 0.55);
  }
  .asb:hover { transform: translateY(-2px); box-shadow: 0 16px 38px -12px rgba(0, 0, 0, 0.6); }
  .asb:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }

  .asb-apple { width: 1.55em; height: 1.55em; font-size: inherit; }

  .asb-text { display: flex; flex-direction: column; align-items: flex-start; gap: 0.18em; }
  /* Proporciones del badge oficial: la línea corta en versalitas sobre el
     nombre de la tienda al doble de tamaño. */
  .asb-small { font-size: 0.62em; letter-spacing: 0.02em; }
  .asb-large { font-size: 1.18em; font-weight: 500; letter-spacing: -0.01em; }

  /* El badge se dimensiona por su altura, así que el tamaño de fuente sale
     de ella y no de la cascada del sitio. */
  .asb[style*="50px"] { font-size: 15px; }
  .asb[style*="60px"] { font-size: 18px; }

  @media (prefers-reduced-motion: reduce) {
    .asb, .asb:hover { transition: none; transform: none; }
  }
</style>
