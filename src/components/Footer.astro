---
import { useTranslations, getLocalePath } from "../i18n/utils";
import type { Locale } from "../i18n/translations";

interface Props { lang?: Locale; }
const lang = (Astro.props.lang ?? "en") as Locale;
const t = useTranslations(lang);
---

<footer class="relative py-20 px-6 bg-golden-deep text-warm-white">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="font-dear text-3xl sm:text-4xl text-warm-white/90 mb-4" style="font-style: italic;">
        {t("footer.cta")}
      </h2>
      <p class="text-warm-white/50 font-light mb-8 max-w-md mx-auto">
        {t("footer.ctaBody")}
      </p>
      <a
        href={`${getLocalePath(lang)}#waitlist`}
        class="inline-block px-8 py-3.5 rounded-2xl bg-breath text-earth font-semibold hover:bg-amber transition-all duration-500 shadow-lg shadow-breath/20"
      >
        {t("nav.waitlist")}
      </a>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-between gap-8 pt-10 border-t border-warm-white/8">
      <div class="flex items-baseline gap-1.5">
        <span class="font-dear text-sm text-warm-white/60">Dear</span>
        <span class="font-wander text-sm text-warm-white/60">Wander</span>
      </div>

      <nav class="flex items-center gap-6 text-sm text-warm-white/40">
        <a href={`${getLocalePath(lang)}#journal`} class="hover:text-warm-white/70 transition-colors duration-400">{t("nav.journal")}</a>
        <a href={`${getLocalePath(lang)}/privacy`} class="hover:text-warm-white/70 transition-colors duration-400">{t("footer.privacy")}</a>
        <a href="https://instagram.com/dearwander" target="_blank" rel="noopener" class="hover:text-warm-white/70 transition-colors duration-400">Instagram</a>
        <a href="https://tiktok.com/@dearwander" target="_blank" rel="noopener" class="hover:text-warm-white/70 transition-colors duration-400">TikTok</a>
      </nav>

      <p class="text-xs text-warm-white/25 font-light">
        &copy; Dear Wander, 2026
      </p>
    </div>
  </div>
</footer>
