---
import { useTranslations, getLocalePath } from "../i18n/utils";
import type { Locale } from "../i18n/translations";

interface Props { lang?: Locale; }
const lang = (Astro.props.lang ?? "en") as Locale;
const t = useTranslations(lang);
---

<footer class="relative py-20 px-6 bg-golden-deep text-warm-white">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="font-dear text-3xl sm:text-4xl text-warm-white/90 mb-4" style="font-style: italic;">
        {t("footer.cta")}
      </h2>
      <p class="text-warm-white/50 font-light mb-8 max-w-md mx-auto">
        {t("footer.ctaBody")}
      </p>
      <form class="flex flex-col sm:flex-row items-center justify-center gap-3 max-w-md mx-auto" id="footer-waitlist-form">
        <input
          type="email"
          name="email"
          placeholder={t("waitlist.placeholder")}
          required
          class="w-full sm:flex-1 px-5 py-3.5 rounded-2xl bg-warm-white/10 backdrop-blur-sm border border-warm-white/15 text-warm-white placeholder:text-warm-white/35 focus:outline-none focus:border-breath/50 focus:ring-2 focus:ring-breath/15 transition-all text-base"
        />
        <button
          type="submit"
          id="footer-waitlist-btn"
          class="w-full sm:w-auto px-8 py-3.5 rounded-2xl bg-breath text-earth font-semibold hover:bg-amber transition-all duration-500 shadow-lg shadow-breath/20 cursor-pointer"
        >
          {t("nav.waitlist")}
        </button>
      </form>

      <script>
        const fForm = document.getElementById("footer-waitlist-form") as HTMLFormElement;
        const fBtn = document.getElementById("footer-waitlist-btn") as HTMLButtonElement;
        if (fForm && fBtn) {
          fForm.addEventListener("submit", async (e) => {
            e.preventDefault();
            const email = (fForm.querySelector('input[name="email"]') as HTMLInputElement)?.value;
            if (!email) return;
            fBtn.textContent = "Sending...";
            fBtn.disabled = true;
            fBtn.style.opacity = "0.6";
            try {
              await fetch("https://buttondown.com/api/emails/embed-subscribe/gabrielaale", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: new URLSearchParams({ email }),
              });
            } catch {}
            fBtn.textContent = "You're in!";
            fBtn.style.opacity = "1";
            (fForm.querySelector('input[name="email"]') as HTMLInputElement).value = "";
          });
        }
      </script>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-between gap-8 pt-10 border-t border-warm-white/8">
      <div class="flex items-baseline gap-1.5">
        <span class="font-dear text-sm text-warm-white/60">Dear</span>
        <span class="font-wander text-sm text-warm-white/60">Wander</span>
      </div>

      <nav class="flex items-center gap-6 text-sm text-warm-white/40 flex-wrap justify-center">
        <a href={`${getLocalePath(lang)}#journal`} class="hover:text-warm-white/70 transition-colors duration-400">{t("nav.journal")}</a>
        <a href="/letters" class="hover:text-warm-white/70 transition-colors duration-400">7 Letters</a>
        <a href="/glossary" class="hover:text-warm-white/70 transition-colors duration-400">Glossary</a>
        <a href="/privacy" class="hover:text-warm-white/70 transition-colors duration-400">{t("footer.privacy")}</a>
        <a href="https://instagram.com/dearwander.app" target="_blank" rel="noopener" class="hover:text-warm-white/70 transition-colors duration-400">Instagram</a>
        <a href="https://tiktok.com/@dearwander.app" target="_blank" rel="noopener" class="hover:text-warm-white/70 transition-colors duration-400">TikTok</a>
      </nav>

      <p class="text-xs text-warm-white/25 font-light">
        &copy; Dear Wander, 2026
      </p>
    </div>
  </div>
</footer>
