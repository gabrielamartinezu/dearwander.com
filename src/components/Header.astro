---
import { useTranslations, getLocalePath, locales, type Locale } from "../i18n/utils";
import type { Locale as LocaleType } from "../i18n/translations";

interface Props { lang?: LocaleType; }
const lang = (Astro.props.lang ?? "en") as LocaleType;
const t = useTranslations(lang);
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-700" id="site-header">
  <nav class="max-w-5xl mx-auto px-6 py-5 flex items-center justify-between">
    <a href={getLocalePath(lang)} class="flex items-baseline gap-1.5 group">
      <span class="font-dear text-[1.5rem] text-earth leading-none transition-colors duration-500 group-hover:text-breath">Dear</span>
      <span class="font-wander text-[1.6rem] text-earth leading-none transition-colors duration-500 group-hover:text-breath">Wander</span>
    </a>

    <div class="flex items-center gap-6 sm:gap-8">
      <a href={`${getLocalePath(lang)}#how-it-works`} class="text-sm font-medium text-taupe hover:text-earth transition-colors duration-400 hidden sm:block">
        {t("nav.howItWorks")}
      </a>
      <a href={`${getLocalePath(lang)}#journal`} class="text-sm font-medium text-taupe hover:text-earth transition-colors duration-400 hidden sm:block">
        {t("nav.journal")}
      </a>
      <a href="/blog/" class="text-sm font-medium text-taupe hover:text-earth transition-colors duration-400 hidden sm:block">
        Blog
      </a>

      <!-- Language switcher -->
      <div class="flex items-center gap-1 text-xs text-taupe/60">
        {locales.map((loc) => (
          <a
            href={getLocalePath(loc.code)}
            class:list={[
              "px-1.5 py-0.5 rounded transition-colors duration-300",
              loc.code === lang
                ? "text-earth font-semibold"
                : "hover:text-earth/80"
            ]}
          >
            {loc.label}
          </a>
        ))}
      </div>

      <a
        href={`${getLocalePath(lang)}#waitlist`}
        class="text-sm font-semibold px-5 py-2.5 rounded-full bg-earth text-warm-white hover:bg-cocoa transition-all duration-500 shadow-lg shadow-earth/10"
      >
        {t("nav.waitlist")}
      </a>
    </div>
  </nav>
</header>

<script>
  const header = document.getElementById("site-header");
  window.addEventListener("scroll", () => {
    if (window.scrollY > 60) {
      header?.classList.add("backdrop-blur-xl", "bg-golden-start/70");
    } else {
      header?.classList.remove("backdrop-blur-xl", "bg-golden-start/70");
    }
  }, { passive: true });
</script>
