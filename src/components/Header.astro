---
import { useTranslations, getLocalePath, locales, type Locale } from "../i18n/utils";
import type { Locale as LocaleType } from "../i18n/translations";

interface Props { lang?: LocaleType; lightBg?: boolean; }
const lang = (Astro.props.lang ?? "en") as LocaleType;
const lightBg = Astro.props.lightBg ?? false;
const t = useTranslations(lang);
const initialClass = lightBg ? "header-light" : "header-hero";
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-700" id="site-header" class:list={[initialClass]} data-initial={initialClass}>
  <nav class="max-w-5xl mx-auto px-6 py-5 flex items-center justify-between">
    <a href={getLocalePath(lang)} class="flex items-baseline gap-1.5 group">
      <span class="font-dear text-[1.5rem] header-brand leading-none transition-colors duration-500 group-hover:text-breath">Dear</span>
      <span class="font-wander text-[1.6rem] header-brand leading-none transition-colors duration-500 group-hover:text-breath">Wander</span>
    </a>

    <div class="flex items-center gap-6 sm:gap-8">
      <a href={`${getLocalePath(lang)}#how-it-works`} class="text-sm font-medium header-link transition-colors duration-400 hidden sm:block">
        {t("nav.howItWorks")}
      </a>
      <!-- One entry, not two. "Journal" used to point at the homepage section
           and "Blog" at the index — the same thing under two names, and from
           a subpage the first one threw you back to the homepage. The section
           is called The Journal everywhere else (the /blog heading, the
           breadcrumb, the back link at the foot of each post), so that is the
           name that stays. -->
      <a href={getLocalePath(lang, "/blog/")} class="text-sm font-medium header-link transition-colors duration-400 hidden sm:block">
        {t("nav.journal")}
      </a>

      <!-- Language switcher -->
      <div class="flex items-center gap-1 text-xs header-lang">
        {locales.map((loc) => (
          <a
            href={getLocalePath(loc.code)}
            class:list={[
              "px-1.5 py-0.5 rounded transition-colors duration-300",
              loc.code === lang
                ? "font-semibold"
                : "opacity-60"
            ]}
          >
            {loc.label}
          </a>
        ))}
      </div>

      <a
        href={`${getLocalePath(lang)}#waitlist`}
        class="text-sm font-semibold px-5 py-2.5 rounded-full bg-earth text-warm-white hover:bg-cocoa transition-all duration-500 shadow-lg shadow-earth/10"
      >
        {t("nav.waitlist")}
      </a>
    </div>
  </nav>
</header>

<style>
  /* Initial state: light text over dark blurred hero */
  .header-hero .header-brand { color: #FFF8F0; }
  .header-hero .header-link { color: rgba(255,248,240,0.75); }
  .header-hero .header-link:hover { color: #FFF8F0; }
  .header-hero .header-lang { color: rgba(255,248,240,0.5); }

  /* Scrolled state: dark text over light blurred background */
  .header-scrolled .header-brand { color: #2A1810; }
  .header-scrolled .header-link { color: #8B7355; }
  .header-scrolled .header-link:hover { color: #2A1810; }
  .header-scrolled .header-lang { color: #8B7355; }

  /* Light-background pages: dark text from the top, no backdrop until scroll */
  .header-light .header-brand { color: #2A1810; }
  .header-light .header-link { color: #8B7355; }
  .header-light .header-link:hover { color: #2A1810; }
  .header-light .header-lang { color: #8B7355; }
</style>

<script>
  const header = document.getElementById("site-header");
  const initial = header?.dataset.initial ?? "header-hero";
  window.addEventListener("scroll", () => {
    if (window.scrollY > 60) {
      header?.classList.add("backdrop-blur-xl", "bg-golden-start/70", "header-scrolled");
      header?.classList.remove(initial);
    } else {
      header?.classList.remove("backdrop-blur-xl", "bg-golden-start/70", "header-scrolled");
      header?.classList.add(initial);
    }
  }, { passive: true });
</script>
