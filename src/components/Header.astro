---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-700" id="site-header">
  <nav class="max-w-5xl mx-auto px-6 py-5 flex items-center justify-between">
    <!-- Wordmark -->
    <a href="/" class="flex items-baseline gap-1.5 group">
      <span class="font-dear text-[1.1rem] text-earth leading-none transition-colors duration-500 group-hover:text-breath">Dear</span>
      <span class="font-wander text-[1.2rem] text-earth leading-none transition-colors duration-500 group-hover:text-breath">Wander</span>
    </a>

    <!-- Nav links -->
    <div class="flex items-center gap-8">
      <a href="#how-it-works" class="text-sm font-medium text-taupe hover:text-earth transition-colors duration-400 hidden sm:block">
        How it works
      </a>
      <a href="#journal" class="text-sm font-medium text-taupe hover:text-earth transition-colors duration-400 hidden sm:block">
        Journal
      </a>
      <a
        href="#waitlist"
        class="text-sm font-semibold px-5 py-2.5 rounded-full bg-earth text-warm-white hover:bg-cocoa transition-all duration-500 shadow-lg shadow-earth/10"
      >
        Join the waitlist
      </a>
    </div>
  </nav>
</header>

<script>
  const header = document.getElementById("site-header");
  let lastScroll = 0;

  window.addEventListener("scroll", () => {
    const y = window.scrollY;
    if (y > 60) {
      header?.classList.add("backdrop-blur-xl", "bg-golden-start/70");
    } else {
      header?.classList.remove("backdrop-blur-xl", "bg-golden-start/70");
    }
    lastScroll = y;
  }, { passive: true });
</script>
