---
import { useTranslations } from "../i18n/utils";
import type { Locale } from "../i18n/translations";
import AppStoreButton from "./AppStoreButton.astro";

interface Props { lang?: Locale; }
const lang = (Astro.props.lang ?? "en") as Locale;
const t = useTranslations(lang);

// Las mismas tres pantallas y las mismas etiquetas que usaba AppShowcase.
// El alt no repite la etiqueta: describe lo que se ve, que es lo que necesita
// quien navega con lector de pantalla.
const screens = [
  { img: "/app/breathing.webp", label: t("appshow.pause.label"),   alt: "Dear Wander's breathing screen, an amber orb expanding over a warm cream background" },
  { img: "/app/home.webp",      label: t("appshow.home.label"),    alt: "The Dear Wander home screen showing the day's intention and today's paused moments" },
  { img: "/app/journey.webp",   label: t("appshow.journey.label"), alt: "The Journey screen with earned badges and a count of reclaimed moments" },
];
---

<!--
  Scroll-driven arch peephole hero
  GSAP + ScrollTrigger powered
-->
<div class="hero-root" id="hero-root">
  <div class="hero-scene" id="hero-scene">

    <!-- ① Blurred landscape backdrop (tiny image, blurred in CSS) -->
    <div class="hero-backdrop">
      <img src="/images/landscape-blur.webp" alt="" class="hero-backdrop-img" aria-hidden="true" loading="eager" decoding="async" />
    </div>

    <!-- ② Landscape (clip-path arch + drop-shadow glow) -->
    <div class="hero-landscape" id="hero-landscape">
      <picture>
        <source srcset="/images/landscape.webp" type="image/webp" />
        <img
          src="/images/landscape.jpg"
          alt="Golden rolling hills at sunset in warm amber light"
          class="hero-landscape-img"
          fetchpriority="high"
          width="1920"
          height="1072"
        />
      </picture>
      <div class="hero-vignette" id="hero-vignette"></div>
    </div>

    <!-- ③ Intro content -->
    <div class="hero-intro" id="hero-intro">
      <div class="hi-wordmark fade-up fade-up-d1">
        {/* El logotipo se queda porque es la firma visual de la marca, pero
            baja a <p>: el <h1> tiene que decir qué es esto, no cómo se llama.
            Quien llega desde una búsqueda todavía no sabe el nombre. */}
        <p class="hi-brand">
          <span class="font-dear">Dear</span><span class="font-wander"> Wander</span>
        </p>
        <h1 class="hi-title">{t("hero.h1")}</h1>
        <p class="hi-sub">{t("hero.h2")}</p>
      </div>

      {/* La descarga va aquí arriba y no solo tras la animación: quien ya
          está convencido no debería tener que hacer scroll para instalar. */}
      <div class="hi-cta fade-up fade-up-d2">
        <AppStoreButton lang={lang} from="web-hero-top" size="lg" />
        <p class="hi-free">{t("hero.free")}</p>
      </div>
      <div class="hi-scroll-hint fade-up fade-up-d3">
        <div class="scroll-pip">
          <div class="scroll-dot"></div>
        </div>
        <span class="scroll-label">{t("hero.scroll")}</span>
      </div>

    </div>

    <!-- ④ Letter messages -->
    <div class="letter-stage" aria-hidden="true">
      <p class="letter" id="letter-1" set:html={t("hero.letter1")} />
      <p class="letter" id="letter-2" set:html={t("hero.letter2")} />
      <p class="letter" id="letter-3" set:html={t("hero.letter3")} />
    </div>

    <!-- ⑤ Las tres pantallas de la app.
         Antes aquí había tres tarjetas de texto. Enseñar la app directamente
         quita un paso: quien llega no tiene que imaginarse cómo es. -->
    <div class="cards-stage" id="cards-stage">
      <div class="peek-row">
        {screens.map((s, i) => (
          <figure class={`app-peek gc`} id={`card-${i + 1}`}>
            <div class="peek-frame">
              <img src={s.img} alt={s.alt} width="280" height="608" loading="lazy" decoding="async" />
            </div>
            <figcaption class="peek-label">{s.label}</figcaption>
          </figure>
        ))}
      </div>

      <!-- ⑥ Descarga. Antes había aquí un formulario de lista de espera; la app
      ya está publicada, así que la acción principal es descargarla. La
      captura de correo sigue existiendo en el pie, ahora como las cartas. -->
      <div class="hero-waitlist" id="hero-waitlist">
      <a id="waitlist" aria-hidden="true"></a>
      <AppStoreButton lang={lang} from="web-hero-reveal" size="lg" />
      <p class="waitlist-fine" id="waitlist-msg">{t("hero.free")}</p>
      </div>
    </div>

  </div>
</div>

<style>
  /* ── Container ─────────────────────────── */
  .hero-root { height: 250vh; position: relative; }
  .hero-scene {
    position: relative;
    height: 100vh; width: 100%;
    overflow: hidden;
  }

  /* ── Blurred landscape backdrop ────────── */
  .hero-backdrop {
    position: absolute; inset: 0;
    overflow: hidden;
    z-index: 0;
  }
  .hero-backdrop-img {
    position: absolute; inset: -20px;
    width: calc(100% + 40px); height: calc(100% + 40px);
    object-fit: cover; object-position: center 40%;
    filter: blur(30px) brightness(0.4);
  }

  /* ── Landscape ─────────────────────────── */
  .hero-landscape {
    position: absolute; inset: 0;
    z-index: 1;
    clip-path: inset(18% 37% 18% 37% round 999px 999px 0px 0px);
    filter: drop-shadow(0 0 50px rgba(244,168,90,0.35))
            drop-shadow(0 0 100px rgba(244,168,90,0.15));
    will-change: clip-path, filter;
  }
  .hero-landscape-img {
    width: 100%; height: 100%;
    object-fit: cover; object-position: center 40%;
    display: block;
  }
  .hero-vignette {
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 75% 70% at 50% 50%,
      transparent 45%, rgba(30,18,10,0.45) 100%);
    pointer-events: none;
  }

  /* ── Intro ─────────────────────────────── */
  .hero-intro {
    position: absolute; inset: 0;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    z-index: 10;
  }
  .hi-wordmark { text-align: center; margin-bottom: 3rem; }
  .hi-label {
    font-family: var(--font-sans); font-size: 0.7rem; font-weight: 500;
    letter-spacing: 0.22em; text-transform: uppercase;
    color: rgba(252,234,187,0.4); margin-bottom: 1.25rem;
  }
  .hi-brand {
    font-size: clamp(2.4rem, 6vw, 4rem); line-height: 1;
    color: rgba(255,248,240,0.9); margin-bottom: 1.15rem;
  }
  .hi-brand .font-dear { font-style: italic; font-weight: 300; opacity: 0.75; }
  .hi-title {
    font-family: var(--font-sans); font-weight: 300;
    font-size: clamp(1.35rem, 3.2vw, 2rem); line-height: 1.25;
    color: rgba(255,248,240,0.95); letter-spacing: 0.01em;
    max-width: 20ch; margin: 0 auto 0.85rem;
    /* El titular cae sobre la foto, y arriba el cielo es casi blanco.
       Sin sombra el texto claro desaparece justo ahí. */
    text-shadow: 0 1px 14px rgba(42,24,16,0.75), 0 0 30px rgba(42,24,16,0.45);
  }
  .hi-sub {
    font-family: var(--font-sans); font-weight: 300; font-size: 1.05rem;
    color: rgba(252,234,187,0.85); letter-spacing: 0.03em;
    max-width: 34ch; margin: 0 auto; line-height: 1.5;
    text-shadow: 0 1px 12px rgba(42,24,16,0.8), 0 0 26px rgba(42,24,16,0.5);
  }
  .hi-cta {
    display: flex; flex-direction: column; align-items: center; gap: 0.85rem;
    margin-top: 2.25rem;
  }
  .hi-free {
    font-family: var(--font-sans); font-weight: 300; font-size: 0.8rem;
    color: rgba(252,234,187,0.72); letter-spacing: 0.03em;
    text-shadow: 0 1px 10px rgba(42,24,16,0.7);
  }
  .hi-scroll-hint {
    display: flex; flex-direction: column; align-items: center; gap: 0.6rem;
  }
  .scroll-pip {
    width: 1.25rem; height: 2rem; border-radius: 999px;
    border: 2px solid rgba(252,234,187,0.18);
    display: flex; justify-content: center; padding-top: 0.3rem;
  }
  .scroll-dot {
    width: 0.25rem; height: 0.5rem; border-radius: 999px;
    background: rgba(252,234,187,0.3);
    animation: bounce 2.5s ease-in-out infinite;
  }
  @keyframes bounce { 0%,100%{transform:translateY(0)} 50%{transform:translateY(5px)} }
  .scroll-label {
    font-family: var(--font-sans); font-size: 0.65rem;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: rgba(252,234,187,0.25);
  }

  /* ── Letters ───────────────────────────── */
  .letter-stage {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    z-index: 8; pointer-events: none;
  }
  .letter {
    position: absolute;
    font-family: var(--font-serif); font-style: italic; font-weight: 300;
    font-size: clamp(1.5rem, 3.5vw, 2.5rem); line-height: 1.5;
    color: rgba(252,234,187,0.85);
    text-align: center; max-width: 560px; padding: 0 2rem;
    opacity: 0;
  }

  /* ── Glass cards ───────────────────────── */
  .cards-stage {
    position: absolute; inset: 0;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    padding: 4.5rem 1.5rem 2rem;
    z-index: 15; pointer-events: none;
  }
  .peek-row {
    display: flex; align-items: flex-start; justify-content: center;
    gap: clamp(0.75rem, 2vw, 1.75rem);
  }
  /* Los tres teléfonos flotando sobre el trigo. El alto sale de la altura de
     la ventana y no de un número fijo: la escena vive dentro de 100vh y el
     botón de descarga va debajo, así que un alto fijo desborda en portátiles
     de pantalla corta. */
  .app-peek {
    display: flex; flex-direction: column; align-items: center;
    gap: 0.85rem;
    opacity: 0; transform: translateY(24px);
    pointer-events: auto;
  }
  .peek-frame {
    width: min(178px, 19vh, 22vw);
    padding: 6px;
    border-radius: 2.2rem;
    background: linear-gradient(155deg, #3a2719, #2A1810);
    box-shadow: 0 24px 55px -14px rgba(42, 24, 16, 0.5);
  }
  .peek-frame img {
    width: 100%; height: auto; display: block;
    border-radius: 1.8rem;
  }
  .peek-label {
    font-family: var(--font-sans); font-weight: 400; font-size: 0.9rem;
    letter-spacing: 0.03em;
    color: rgba(255,248,240,0.92);
    text-shadow: 0 1px 12px rgba(42,24,16,0.55);
  }

  .card-icon { color: var(--color-breath); margin-bottom: 0.85rem; }
  .card-title {
    font-family: var(--font-serif); font-weight: 700;
    font-size: 1.15rem; color: #2A1810; margin-bottom: 0.5rem;
  }
  .card-body {
    font-family: var(--font-sans); font-size: 0.85rem; font-weight: 400;
    color: #3C2A1E; line-height: 1.65;
  }

  /* ── Waitlist ──────────────────────────── */
  /* Antes iba anclado a bottom:12vh, independiente de los teléfonos, y en
     pantallas cortas se le montaba encima. Ahora va en el mismo flujo. */
  .hero-waitlist {
    display: flex; flex-direction: column; align-items: center; gap: 0.7rem;
    margin-top: clamp(1.25rem, 3vh, 2.25rem);
    z-index: 20; text-align: center;
    opacity: 0; pointer-events: none;
  }
  .download-btn {
    display: inline-flex; align-items: center; gap: 0.6rem;
    padding: 0.95rem 1.7rem; border-radius: 999px;
    background: #2A1810; color: #FFF8F0;
    font-family: var(--font-sans); font-size: 0.95rem; font-weight: 600;
    text-decoration: none; white-space: nowrap;
    box-shadow: 0 10px 30px -8px rgba(42,24,16,0.45);
    transition: transform 0.4s, box-shadow 0.4s, background 0.4s;
  }
  .download-btn:hover {
    background: #3C2A1E; transform: translateY(-2px);
    box-shadow: 0 16px 38px -10px rgba(42,24,16,0.55);
  }
  .download-btn:focus-visible { outline: 3px solid rgba(244,168,90,0.9); outline-offset: 3px; }
  /* Se apoya sobre la ladera oscura, no sobre el crema: en marrón al 35% era
     invisible. Y 0.68rem es ilegible en un teléfono. */
  .waitlist-fine {
    font-family: var(--font-sans); font-weight: 300; font-size: 0.8rem;
    color: rgba(255,248,240,0.75); letter-spacing: 0.03em;
    /* La letra pequeña cae sobre el trigo, que es claro y con mucho detalle.
       Sin sombra el texto se pierde dentro del grano. */
    text-shadow: 0 1px 10px rgba(42,24,16,0.85), 0 0 22px rgba(42,24,16,0.6);
  }

  /* ── Mobile: static layout, no scroll animation ── */
  @media (max-width: 700px) {
    .hero-root {
      height: auto;
    }
    .hero-scene {
      height: auto;
      min-height: 100vh;
      min-height: 100svh;
      display: flex;
      flex-direction: column;
      position: relative;
    }
    .hero-backdrop {
      display: none;
    }
    .hero-landscape {
      position: absolute; inset: 0;
      clip-path: none !important;
      filter: none !important;
    }
    .hero-landscape::after {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(to bottom,
        rgba(30,18,10,0.3) 0%,
        rgba(30,18,10,0.15) 30%,
        rgba(30,18,10,0.25) 60%,
        rgba(30,18,10,0.55) 100%);
    }
    .hero-vignette { display: none; }

    .hero-intro {
      position: relative;
      flex: none;
      padding: 6rem 1.5rem 2rem;
      z-index: 10;
    }
    .hi-wordmark { margin-bottom: 1.5rem; }
    .hi-brand { font-size: 2.4rem; color: rgba(255,248,240,0.95); }
    .hi-title { font-size: 1.25rem; color: rgba(255,248,240,0.95); }
    .hi-cta { margin-top: 1.75rem; }
    .hi-sub { color: rgba(252,234,187,0.9); font-size: 0.98rem; }
    .hi-scroll-hint { display: none; }

    .letter-stage { display: none; }

    /* La escena deja de estar fija en móvil: todo pasa a flujo normal. La
       columna se queda (fila de teléfonos arriba, botón debajo) y lo que se
       pone en fila es .peek-row, no el contenedor. Ponerlo aquí dejaba el
       botón de descarga al lado de los teléfonos en vez de debajo. */
    .cards-stage {
      position: relative;
      flex-direction: column;
      align-items: center;
      padding: 1rem 1.25rem 2rem;
      gap: 0.75rem;
      z-index: 10;
    }
    .peek-row { gap: 0.55rem; width: 100%; }
    .app-peek {
      opacity: 1 !important;
      transform: none !important;
      gap: 0.5rem;
      flex: 1 1 0; min-width: 0;
    }
    .peek-frame, #card-2 .peek-frame { width: 100%; padding: 4px; border-radius: 1.4rem; }
    .peek-frame img { border-radius: 1.15rem; }
    .peek-label { font-size: 0.72rem; text-align: center; }

    /* Antes el botón de descarga estaba en display:none en móvil, que es
       justo el dispositivo donde se puede instalar la app. Ahora se ven los
       dos: en móvil la escena no está fija, va en flujo normal, así que el
       segundo cae al final de una página larga y no repite nada en pantalla. */
    .hi-cta { margin-top: 1.5rem; }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Skip scroll animation on mobile — show static layout
  const isMobile = window.matchMedia("(max-width: 700px)").matches;
  if (isMobile) {
    // Cards and waitlist are visible via CSS !important overrides
    // Nothing to animate
  }

  // ── Arch clip-path interpolation ─────────────────
  function archClip(progress: number) {
    const iSide = (1 - progress) * 37;
    const iTop  = (1 - progress) * 18;
    const iBot  = (1 - progress) * 18;
    const visW  = window.innerWidth * (1 - 2 * iSide / 100);
    const archFactor = Math.pow(1 - progress, 1.2);
    const rad = (visW / 2) * archFactor;
    return `inset(${iTop}% ${iSide}% ${iBot}% ${iSide}% round ${rad}px ${rad}px 0px 0px)`;
  }

  function archGlow(progress: number) {
    const f = Math.pow(1 - progress, 1.2);
    const s = Math.round(50 + 30 * f);
    const a1 = Math.max(10, Math.round(35 * f));
    const a2 = Math.max(5, Math.round(17 * f));
    return `drop-shadow(0 0 ${s}px rgba(244,168,90,0.${a1})) drop-shadow(0 0 ${s*2}px rgba(244,168,90,0.${a2}))`;
  }

  // ── Master timeline (desktop only) ───────────────
  if (!isMobile) {
    const landscape = document.getElementById("hero-landscape")!;
    const vignette  = document.getElementById("hero-vignette")!;

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: "#hero-root",
        start: "top top",
        end: "bottom bottom",
        scrub: 0.8,
        pin: "#hero-scene",
        pinSpacing: false,
      },
    });

    // — Phase 1: Intro fades out (0→15%)
    tl.to("#hero-intro", { opacity: 0, duration: 0.15, ease: "power2.in" }, 0);

    // — Arch expands across the full timeline via onUpdate
    const archProxy = { p: 0 };
    tl.to(archProxy, {
      p: 1,
      duration: 1,
      ease: "power2.inOut",
      onUpdate() {
        landscape.style.clipPath = archClip(archProxy.p);
        landscape.style.filter   = archGlow(archProxy.p);
        const f = Math.pow(1 - archProxy.p, 1.2);
        const s = 45 + archProxy.p * 55;
        vignette.style.background =
          `radial-gradient(ellipse ${s}% ${s}% at 50% 50%, transparent ${s}%, rgba(30,18,10,${(0.5*f).toFixed(2)}) 100%)`;
      },
    }, 0);

    // — Phase 2: Letters sequence (10→75%)
    tl.fromTo("#letter-1", { opacity: 0 }, { opacity: 1, duration: 0.08, ease: "power1.in" }, 0.10);
    tl.to("#letter-1", { opacity: 0, duration: 0.08, ease: "power1.out" }, 0.26);
    tl.fromTo("#letter-2", { opacity: 0 }, { opacity: 1, duration: 0.08, ease: "power1.in" }, 0.32);
    tl.to("#letter-2", { opacity: 0, duration: 0.08, ease: "power1.out" }, 0.48);
    tl.fromTo("#letter-3", { opacity: 0 }, { opacity: 1, duration: 0.08, ease: "power1.in" }, 0.52);
    tl.to("#letter-3", { opacity: 0, duration: 0.08, ease: "power1.out" }, 0.68);

    // — Phase 3: Glass cards stagger in (78→96%)
    tl.fromTo(".gc",
      { opacity: 0, y: 24 },
      { opacity: 1, y: 0, duration: 0.10, stagger: 0.04, ease: "power2.out" },
      0.78
    );

    // — Phase 4: Waitlist slides up (90→100%)
    tl.fromTo("#hero-waitlist",
      { opacity: 0, y: 16 },
      { opacity: 1, y: 0, duration: 0.10, ease: "power2.out",
        onComplete() {
          document.getElementById("hero-waitlist")!.style.pointerEvents = "auto";
        }
      },
      0.90
    );
  }

  // El hero ya no captura correo: la app está publicada y la acción
  // principal es descargarla. La captura sigue viva en el pie, con su
  // propio manejador en Footer.astro.
</script>
