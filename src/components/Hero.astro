---
import { useTranslations } from "../i18n/utils";
import type { Locale } from "../i18n/translations";

interface Props { lang?: Locale; }
const lang = (Astro.props.lang ?? "en") as Locale;
const t = useTranslations(lang);
---

<!--
  Scroll-driven arch peephole hero
  GSAP + ScrollTrigger powered
-->
<div class="hero-root" id="hero-root">
  <div class="hero-scene" id="hero-scene">

    <!-- ① Dark backdrop -->
    <div class="hero-backdrop"></div>

    <!-- ② Landscape (clip-path arch + drop-shadow glow) -->
    <div class="hero-landscape" id="hero-landscape">
      <img
        src="/images/landscape.jpg"
        alt="Golden rolling hills at sunset — warm amber light"
        class="hero-landscape-img"
        fetchpriority="high"
      />
      <div class="hero-vignette" id="hero-vignette"></div>
    </div>

    <!-- ③ Intro content -->
    <div class="hero-intro" id="hero-intro">
      <div class="hi-wordmark fade-up fade-up-d1">
        <p class="hi-label">{t("hero.label")}</p>
        <h1 class="hi-title">
          <span class="font-dear">Dear</span><span class="font-wander"> Wander</span>
        </h1>
        <p class="hi-sub">{t("hero.sub")}</p>
      </div>
      <div class="hi-scroll-hint fade-up fade-up-d3">
        <div class="scroll-pip">
          <div class="scroll-dot"></div>
        </div>
        <span class="scroll-label">{t("hero.scroll")}</span>
      </div>
    </div>

    <!-- ④ Letter messages -->
    <div class="letter-stage" aria-hidden="true">
      <p class="letter" id="letter-1" set:html={t("hero.letter1")} />
      <p class="letter" id="letter-2" set:html={t("hero.letter2")} />
      <p class="letter" id="letter-3" set:html={t("hero.letter3")} />
    </div>

    <!-- ⑤ Glassmorphism cards -->
    <div class="cards-stage" id="cards-stage">
      <div class="glass-card gc" id="card-1">
        <div class="card-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5" opacity="0.6"/>
            <circle cx="12" cy="12" r="4" fill="currentColor" opacity="0.45"/>
          </svg>
        </div>
        <h3 class="card-title">{t("hero.pause.title")}</h3>
        <p class="card-body">{t("hero.pause.body")}</p>
      </div>

      <div class="glass-card gc" id="card-2">
        <div class="card-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z" stroke="currentColor" stroke-width="1.5" opacity="0.6"/>
            <path d="M12 6v6l4.5 2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/>
          </svg>
        </div>
        <h3 class="card-title">{t("hero.wander.title")}</h3>
        <p class="card-body">{t("hero.wander.body")}</p>
      </div>

      <div class="glass-card gc" id="card-3">
        <div class="card-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <path d="M3 12l9-8 9 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/>
            <path d="M5 10v9a1 1 0 001 1h12a1 1 0 001-1v-9" stroke="currentColor" stroke-width="1.5" opacity="0.6"/>
          </svg>
        </div>
        <h3 class="card-title">{t("hero.home.title")}</h3>
        <p class="card-body">{t("hero.home.body")}</p>
      </div>
    </div>

    <!-- ⑥ Waitlist -->
    <div class="hero-waitlist" id="hero-waitlist">
      <a id="waitlist" aria-hidden="true"></a>
      <form class="waitlist-form" id="waitlist-form">
        <input type="email" name="email" placeholder={t("waitlist.placeholder")} required class="waitlist-input"/>
        <button type="submit" class="waitlist-btn" id="waitlist-btn">{t("waitlist.button")}</button>
      </form>
      <p class="waitlist-fine" id="waitlist-msg">{t("waitlist.fine")}</p>
    </div>

  </div>
</div>

<style>
  /* ── Container ─────────────────────────── */
  .hero-root { height: 250vh; position: relative; }
  .hero-scene {
    position: relative;
    height: 100vh; width: 100%;
    overflow: hidden;
  }

  /* ── Dark backdrop ─────────────────────── */
  .hero-backdrop {
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 80% 60% at 50% 55%, #4A2A18 0%, #2A1810 55%, #1A0E08 100%);
  }

  /* ── Landscape ─────────────────────────── */
  .hero-landscape {
    position: absolute; inset: 0;
    clip-path: inset(18% 37% 18% 37% round 999px 999px 0px 0px);
    filter: drop-shadow(0 0 50px rgba(244,168,90,0.35))
            drop-shadow(0 0 100px rgba(244,168,90,0.15));
    will-change: clip-path, filter;
  }
  .hero-landscape-img {
    width: 100%; height: 100%;
    object-fit: cover; object-position: center 40%;
    display: block;
  }
  .hero-vignette {
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 75% 70% at 50% 50%,
      transparent 45%, rgba(30,18,10,0.45) 100%);
    pointer-events: none;
  }

  /* ── Intro ─────────────────────────────── */
  .hero-intro {
    position: absolute; inset: 0;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    z-index: 10;
  }
  .hi-wordmark { text-align: center; margin-bottom: 3rem; }
  .hi-label {
    font-family: var(--font-sans); font-size: 0.7rem; font-weight: 500;
    letter-spacing: 0.22em; text-transform: uppercase;
    color: rgba(252,234,187,0.4); margin-bottom: 1.25rem;
  }
  .hi-title {
    font-size: clamp(3rem, 8vw, 5.5rem); line-height: 1;
    color: rgba(255,248,240,0.9); margin-bottom: 1rem;
  }
  .hi-title .font-dear { font-style: italic; font-weight: 300; opacity: 0.75; }
  .hi-sub {
    font-family: var(--font-sans); font-weight: 300; font-size: 1.1rem;
    color: rgba(252,234,187,0.5); letter-spacing: 0.04em;
  }
  .hi-scroll-hint {
    display: flex; flex-direction: column; align-items: center; gap: 0.6rem;
  }
  .scroll-pip {
    width: 1.25rem; height: 2rem; border-radius: 999px;
    border: 2px solid rgba(252,234,187,0.18);
    display: flex; justify-content: center; padding-top: 0.3rem;
  }
  .scroll-dot {
    width: 0.25rem; height: 0.5rem; border-radius: 999px;
    background: rgba(252,234,187,0.3);
    animation: bounce 2.5s ease-in-out infinite;
  }
  @keyframes bounce { 0%,100%{transform:translateY(0)} 50%{transform:translateY(5px)} }
  .scroll-label {
    font-family: var(--font-sans); font-size: 0.65rem;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: rgba(252,234,187,0.25);
  }

  /* ── Letters ───────────────────────────── */
  .letter-stage {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    z-index: 8; pointer-events: none;
  }
  .letter {
    position: absolute;
    font-family: var(--font-serif); font-style: italic; font-weight: 300;
    font-size: clamp(1.5rem, 3.5vw, 2.5rem); line-height: 1.5;
    color: rgba(252,234,187,0.85);
    text-align: center; max-width: 560px; padding: 0 2rem;
    opacity: 0;
  }

  /* ── Glass cards ───────────────────────── */
  .cards-stage {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    padding: 0 1.5rem; gap: 1rem;
    z-index: 15; pointer-events: none;
  }
  .glass-card {
    flex: 1; max-width: 280px;
    background: rgba(255,248,240,0.4);
    backdrop-filter: blur(28px) saturate(1.25);
    -webkit-backdrop-filter: blur(28px) saturate(1.25);
    border: 1px solid rgba(255,248,240,0.35);
    border-radius: 20px; padding: 1.75rem 1.5rem;
    box-shadow: 0 8px 32px rgba(60,42,30,0.18), inset 0 1px 0 rgba(255,255,255,0.4);
    opacity: 0; transform: translateY(24px);
    pointer-events: auto;
  }
  .card-icon { color: var(--color-breath); margin-bottom: 0.85rem; }
  .card-title {
    font-family: var(--font-serif); font-weight: 700;
    font-size: 1.15rem; color: #2A1810; margin-bottom: 0.5rem;
  }
  .card-body {
    font-family: var(--font-sans); font-size: 0.85rem; font-weight: 400;
    color: #3C2A1E; line-height: 1.65;
  }

  /* ── Waitlist ──────────────────────────── */
  .hero-waitlist {
    position: absolute; bottom: 12vh; left: 50%;
    transform: translateX(-50%);
    z-index: 20; text-align: center;
    opacity: 0; pointer-events: none;
  }
  .waitlist-form { display: flex; gap: 0.6rem; width: min(440px, 90vw); }
  .waitlist-input {
    flex: 1; padding: 0.8rem 1.1rem; border-radius: 14px;
    background: rgba(255,248,240,0.4);
    backdrop-filter: blur(28px) saturate(1.25);
    -webkit-backdrop-filter: blur(28px) saturate(1.25);
    border: 1px solid rgba(255,248,240,0.35);
    color: #2A1810; font-size: 0.9rem; font-family: var(--font-sans);
    outline: none; transition: border-color 0.3s, box-shadow 0.3s;
  }
  .waitlist-input::placeholder { color: rgba(42,24,16,0.45); }
  .waitlist-input:focus {
    border-color: rgba(244,168,90,0.6);
    box-shadow: 0 0 0 3px rgba(244,168,90,0.15);
  }
  .waitlist-btn {
    padding: 0.8rem 1.4rem; border-radius: 14px;
    background: rgba(255,248,240,0.4);
    backdrop-filter: blur(28px) saturate(1.25);
    -webkit-backdrop-filter: blur(28px) saturate(1.25);
    border: 1px solid rgba(255,248,240,0.35);
    color: #2A1810; font-family: var(--font-sans);
    font-size: 0.875rem; font-weight: 600;
    cursor: pointer; white-space: nowrap; transition: all 0.4s;
  }
  .waitlist-btn:hover { background: rgba(255,248,240,0.55); }
  .waitlist-fine {
    font-size: 0.68rem; color: rgba(60,42,30,0.35);
    margin-top: 0.5rem; font-family: var(--font-sans); font-weight: 300;
  }

  /* ── Mobile: static layout, no scroll animation ── */
  @media (max-width: 700px) {
    .hero-root {
      height: auto;
    }
    .hero-scene {
      height: auto;
      min-height: 100vh;
      min-height: 100svh;
      display: flex;
      flex-direction: column;
      position: relative;
    }
    .hero-backdrop {
      display: none;
    }
    .hero-landscape {
      position: absolute; inset: 0;
      clip-path: none !important;
      filter: none !important;
    }
    .hero-landscape::after {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(to bottom,
        rgba(30,18,10,0.3) 0%,
        rgba(30,18,10,0.15) 30%,
        rgba(30,18,10,0.25) 60%,
        rgba(30,18,10,0.55) 100%);
    }
    .hero-vignette { display: none; }

    .hero-intro {
      position: relative;
      flex: none;
      padding: 6rem 1.5rem 2rem;
      z-index: 10;
    }
    .hi-wordmark { margin-bottom: 1.5rem; }
    .hi-title { font-size: 2.8rem; color: rgba(255,248,240,0.95); }
    .hi-sub { color: rgba(252,234,187,0.7); }
    .hi-scroll-hint { display: none; }

    .letter-stage { display: none; }

    .cards-stage {
      position: relative;
      flex-direction: column;
      align-items: center;
      padding: 1rem 1.25rem 1.5rem;
      gap: 0.75rem;
      z-index: 10;
    }
    .glass-card {
      max-width: 100%;
      opacity: 1 !important;
      transform: none !important;
      padding: 1.25rem;
    }

    .hero-waitlist {
      display: none;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Skip scroll animation on mobile — show static layout
  const isMobile = window.matchMedia("(max-width: 700px)").matches;
  if (isMobile) {
    // Cards and waitlist are visible via CSS !important overrides
    // Nothing to animate
  }

  // ── Arch clip-path interpolation ─────────────────
  function archClip(progress: number) {
    const iSide = (1 - progress) * 37;
    const iTop  = (1 - progress) * 18;
    const iBot  = (1 - progress) * 18;
    const visW  = window.innerWidth * (1 - 2 * iSide / 100);
    const archFactor = Math.pow(1 - progress, 1.2);
    const rad = (visW / 2) * archFactor;
    return `inset(${iTop}% ${iSide}% ${iBot}% ${iSide}% round ${rad}px ${rad}px 0px 0px)`;
  }

  function archGlow(progress: number) {
    const f = Math.pow(1 - progress, 1.2);
    const s = Math.round(50 + 30 * f);
    const a1 = Math.max(10, Math.round(35 * f));
    const a2 = Math.max(5, Math.round(17 * f));
    return `drop-shadow(0 0 ${s}px rgba(244,168,90,0.${a1})) drop-shadow(0 0 ${s*2}px rgba(244,168,90,0.${a2}))`;
  }

  // ── Master timeline (desktop only) ───────────────
  if (!isMobile) {
    const landscape = document.getElementById("hero-landscape")!;
    const vignette  = document.getElementById("hero-vignette")!;

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: "#hero-root",
        start: "top top",
        end: "bottom bottom",
        scrub: 0.8,
        pin: "#hero-scene",
        pinSpacing: false,
      },
    });

    // — Phase 1: Intro fades out (0→15%)
    tl.to("#hero-intro", { opacity: 0, duration: 0.15, ease: "power2.in" }, 0);

    // — Arch expands across the full timeline via onUpdate
    const archProxy = { p: 0 };
    tl.to(archProxy, {
      p: 1,
      duration: 1,
      ease: "power2.inOut",
      onUpdate() {
        landscape.style.clipPath = archClip(archProxy.p);
        landscape.style.filter   = archGlow(archProxy.p);
        const f = Math.pow(1 - archProxy.p, 1.2);
        const s = 45 + archProxy.p * 55;
        vignette.style.background =
          `radial-gradient(ellipse ${s}% ${s}% at 50% 50%, transparent ${s}%, rgba(30,18,10,${(0.5*f).toFixed(2)}) 100%)`;
      },
    }, 0);

    // — Phase 2: Letters sequence (10→75%)
    tl.fromTo("#letter-1", { opacity: 0 }, { opacity: 1, duration: 0.08, ease: "power1.in" }, 0.10);
    tl.to("#letter-1", { opacity: 0, duration: 0.08, ease: "power1.out" }, 0.26);
    tl.fromTo("#letter-2", { opacity: 0 }, { opacity: 1, duration: 0.08, ease: "power1.in" }, 0.32);
    tl.to("#letter-2", { opacity: 0, duration: 0.08, ease: "power1.out" }, 0.48);
    tl.fromTo("#letter-3", { opacity: 0 }, { opacity: 1, duration: 0.08, ease: "power1.in" }, 0.52);
    tl.to("#letter-3", { opacity: 0, duration: 0.08, ease: "power1.out" }, 0.68);

    // — Phase 3: Glass cards stagger in (78→96%)
    tl.fromTo(".gc",
      { opacity: 0, y: 24 },
      { opacity: 1, y: 0, duration: 0.10, stagger: 0.04, ease: "power2.out" },
      0.78
    );

    // — Phase 4: Waitlist slides up (90→100%)
    tl.fromTo("#hero-waitlist",
      { opacity: 0, y: 16 },
      { opacity: 1, y: 0, duration: 0.10, ease: "power2.out",
        onComplete() {
          document.getElementById("hero-waitlist")!.style.pointerEvents = "auto";
        }
      },
      0.90
    );
  }

  // ── Waitlist form submit with loading state ──────
  const form = document.getElementById("waitlist-form") as HTMLFormElement;
  const btn = document.getElementById("waitlist-btn") as HTMLButtonElement;
  const msg = document.getElementById("waitlist-msg") as HTMLParagraphElement;

  if (form && btn && msg) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = (form.querySelector('input[name="email"]') as HTMLInputElement)?.value;
      if (!email) return;

      btn.textContent = "Sending...";
      btn.disabled = true;
      btn.style.opacity = "0.6";

      try {
        const res = await fetch("https://buttondown.com/api/emails/embed-subscribe/gabrielaale", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: new URLSearchParams({ email }),
        });

        if (res.ok || res.status === 303 || res.status === 302 || res.status === 200) {
          btn.textContent = "You're in!";
          btn.style.opacity = "1";
          msg.textContent = "Check your inbox for a confirmation email.";
          (form.querySelector('input[name="email"]') as HTMLInputElement).value = "";
        } else {
          btn.textContent = "Try again";
          btn.disabled = false;
          btn.style.opacity = "1";
          msg.textContent = "Something went wrong. Please try again.";
        }
      } catch {
        // Fetch can fail due to CORS on redirect — treat as success
        btn.textContent = "You're in!";
        btn.style.opacity = "1";
        msg.textContent = "Check your inbox for a confirmation email.";
        (form.querySelector('input[name="email"]') as HTMLInputElement).value = "";
      }
    });
  }
</script>
