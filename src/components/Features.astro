---
import { useTranslations } from "../i18n/utils";
import type { Locale } from "../i18n/translations";

interface Props { lang?: Locale; }
const lang = (Astro.props.lang ?? "en") as Locale;
const t = useTranslations(lang);
---

<!-- The Problem -->
<section class="relative py-28 sm:py-36 px-6 bg-golden-hour">
  <div class="max-w-3xl mx-auto text-center">
    <div class="reveal">
      <h2 class="font-wander text-3xl sm:text-4xl md:text-5xl text-earth mb-8 leading-snug" set:html={t("problem.title")} />
    </div>
    <div class="reveal" style="transition-delay: 0.15s;">
      <p class="text-lg sm:text-xl text-cocoa/85 leading-relaxed max-w-xl mx-auto font-light">
        <Fragment set:html={t("problem.body")} />
        <em class="font-dear text-xl sm:text-2xl text-earth/80 block mt-4" style="font-style: italic;">{t("problem.quote")}</em>
      </p>
    </div>
  </div>
</section>

<!-- How It Works -->
<section class="relative py-28 sm:py-36 px-6 bg-golden-mid" id="how-it-works">
  <div class="petal w-20 h-24 top-16 right-[10%] opacity-25" style="animation: drift 20s ease-in-out infinite;"></div>
  <div class="petal w-14 h-18 bottom-20 left-[8%] opacity-20" style="animation: drift-alt 24s ease-in-out infinite; animation-delay: -5s;"></div>

  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-16 reveal">
      <h2 class="font-wander text-3xl sm:text-4xl text-earth mb-4">{t("how.title")}</h2>
      <p class="text-taupe text-lg font-light">{t("how.subtitle")}</p>
    </div>

    <!-- A sequence, not three columns: these moments happen one after another,
         and as equal side-by-side cards they read as parallel features. The
         markers on the rail swell and settle across the three, which is the
         shape of the breath the section is describing. -->
    <ol class="how-steps max-w-2xl mx-auto">
      <li class="how-step reveal" style="transition-delay: 0.1s;">
        <span class="how-mark how-mark--in"></span>
        <div>
          <p class="how-index">01</p>
          <h3 class="how-heading font-wander">{t("how.pause.title")}</h3>
          <p class="how-body">{t("how.pause.body")}</p>
        </div>
      </li>

      <li class="how-step how-step--held reveal" style="transition-delay: 0.25s;">
        <span class="how-mark how-mark--hold"></span>
        <div>
          <p class="how-index">02</p>
          <h3 class="how-heading font-wander">{t("how.wander.title")}</h3>
          <p class="how-body">{t("how.wander.body")}</p>
        </div>
      </li>

      <li class="how-step reveal" style="transition-delay: 0.4s;">
        <span class="how-mark how-mark--out"></span>
        <div>
          <p class="how-index">03</p>
          <h3 class="how-heading font-wander">{t("how.home.title")}</h3>
          <p class="how-body">
            <em class="how-quote font-dear">{t("how.home.quote")}</em>
            {" "}{t("how.home.body")}
          </p>
        </div>
      </li>
    </ol>
  </div>
</section>

<style>
  .how-steps {
    position: relative;
    list-style: none;
  }
  /* The rail runs behind the markers and stops short at both ends, so the
     sequence opens and closes rather than being cut off. */
  .how-steps::before {
    content: "";
    position: absolute;
    left: 1.375rem;
    top: 1.5rem;
    bottom: 3rem;
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(244, 168, 90, 0.55) 12%,
      rgba(244, 168, 90, 0.55) 88%,
      transparent
    );
  }

  .how-step {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    gap: 1.5rem;
    padding-bottom: 3.25rem;
  }
  .how-step:last-child {
    padding-bottom: 0;
  }

  .how-mark {
    justify-self: center;
    margin-top: 0.55rem;
    border-radius: 999px;
    background: var(--color-breath);
    box-shadow: 0 0 0 6px rgba(244, 168, 90, 0.14);
  }
  /* Inhale, hold, release. */
  .how-mark--in    { width: 10px; height: 10px; }
  .how-mark--hold  { width: 20px; height: 20px; box-shadow: 0 0 0 10px rgba(244, 168, 90, 0.16); margin-top: 0.4rem; }
  .how-mark--out   { width: 10px; height: 10px; }

  .how-index {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    color: var(--color-taupe);
    opacity: 0.7;
    margin-bottom: 0.4rem;
  }

  .how-heading {
    font-size: 1.5rem;
    color: var(--color-earth);
    margin-bottom: 0.6rem;
    line-height: 1.2;
  }
  /* The held moment is given the most room, matching its marker. */
  .how-step--held .how-heading {
    font-size: 1.875rem;
  }
  .how-step--held .how-body {
    font-size: 1.125rem;
  }

  .how-body {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-cocoa);
  }

  .how-quote {
    font-style: italic;
    font-size: 1.15em;
    color: var(--color-earth);
  }

  @media (max-width: 640px) {
    .how-steps::before { left: 0.9375rem; }
    .how-step {
      grid-template-columns: 1.875rem 1fr;
      gap: 1rem;
      padding-bottom: 2.5rem;
    }
    .how-heading { font-size: 1.375rem; }
    .how-step--held .how-heading { font-size: 1.625rem; }
  }
</style>

<!-- First Light & Last Light -->
<section class="relative py-28 sm:py-36 px-6 bg-golden-hour overflow-hidden">
  <div class="petal w-24 h-30 top-[20%] left-[5%] opacity-20" style="animation: drift-alt 26s ease-in-out infinite;"></div>

  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-16 reveal">
      <h2 class="font-wander text-3xl sm:text-4xl text-earth mb-4">{t("rituals.title")}</h2>
    </div>

    <div class="grid sm:grid-cols-2 gap-8">
      <div class="glass p-10 sm:p-12 text-center reveal" style="transition-delay: 0.1s;">
        <div class="w-20 h-20 rounded-full mx-auto mb-6" style="background: radial-gradient(circle, #FCEABB 0%, #F4A85A 60%, transparent 100%); opacity: 0.7;"></div>
        <h3 class="font-wander text-2xl text-earth mb-2">{t("rituals.first.title")}</h3>
        <p class="font-dear text-lg text-taupe mb-4" style="font-style: italic;">{t("rituals.first.sub")}</p>
        <p class="text-cocoa/80 font-light leading-relaxed">{t("rituals.first.body")}</p>
      </div>

      <div class="glass-dark p-10 sm:p-12 text-center reveal" style="transition-delay: 0.25s;">
        <div class="w-20 h-20 rounded-full mx-auto mb-6" style="background: radial-gradient(circle, #F4A85A 0%, #5C4E7A 70%, transparent 100%); opacity: 0.6;"></div>
        <h3 class="font-wander text-2xl text-earth mb-2">{t("rituals.last.title")}</h3>
        <p class="font-dear text-lg text-dusk/70 mb-4" style="font-style: italic;">{t("rituals.last.sub")}</p>
        <p class="text-cocoa/80 font-light leading-relaxed">{t("rituals.last.body")}</p>
      </div>
    </div>
  </div>
</section>

<!-- What makes us different -->
<section class="relative py-28 sm:py-36 px-6 bg-golden-deep text-warm-white overflow-hidden">
  <div class="petal w-20 h-24 top-[15%] right-[8%] opacity-10" style="animation: drift 22s ease-in-out infinite; border-color: rgba(252, 234, 187, 0.08);"></div>

  <div class="max-w-3xl mx-auto text-center">
    <div class="reveal">
      <h2 class="font-wander text-3xl sm:text-4xl text-warm-white mb-6 leading-snug">
        {t("diff.title")}<br />
        <span class="font-dear text-4xl sm:text-5xl" style="font-style: italic;" set:html={t("diff.subtitle")} />
      </h2>
    </div>

    <div class="grid sm:grid-cols-3 gap-8 mt-16">
      <div class="reveal" style="transition-delay: 0.1s;">
        <div class="text-3xl mb-4 opacity-70">&#10047;</div>
        <h3 class="font-wander text-lg text-warm-white mb-2">{t("diff.native.title")}</h3>
        <p class="text-warm-white/60 font-light text-sm leading-relaxed">{t("diff.native.body")}</p>
      </div>
      <div class="reveal" style="transition-delay: 0.25s;">
        <div class="text-3xl mb-4 opacity-70">&#9670;</div>
        <h3 class="font-wander text-lg text-warm-white mb-2">{t("diff.private.title")}</h3>
        <p class="text-warm-white/60 font-light text-sm leading-relaxed">{t("diff.private.body")}</p>
      </div>
      <div class="reveal" style="transition-delay: 0.4s;">
        <div class="text-3xl mb-4 opacity-70">&#9825;</div>
        <h3 class="font-wander text-lg text-warm-white mb-2">{t("diff.kind.title")}</h3>
        <p class="text-warm-white/60 font-light text-sm leading-relaxed">{t("diff.kind.body")}</p>
      </div>
    </div>
  </div>
</section>

<!-- Testimonials -->
<section class="relative py-28 sm:py-36 px-6 bg-golden-hour">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-16 reveal">
      <p class="font-dear text-xl text-taupe" style="font-style: italic;">{t("testimonials.label")}</p>
    </div>

    <div class="grid sm:grid-cols-2 gap-8">
      <div class="glass p-8 reveal" style="transition-delay: 0.1s;">
        <p class="text-cocoa/85 font-light leading-relaxed mb-4">{t("testimonials.1")}</p>
        <p class="text-sm text-taupe font-medium">{t("testimonials.1.author")}</p>
      </div>
      <div class="glass p-8 reveal" style="transition-delay: 0.25s;">
        <p class="text-cocoa/85 font-light leading-relaxed mb-4">{t("testimonials.2")}</p>
        <p class="text-sm text-taupe font-medium">{t("testimonials.2.author")}</p>
      </div>
    </div>
  </div>
</section>
