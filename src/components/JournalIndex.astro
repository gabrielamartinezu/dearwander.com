---
/**
 * The Journal index, one language at a time.
 *
 * Posts carry their language as a slug prefix (es-…, it-…) rather than living
 * under a locale route, so filtering happens on that prefix. Without it the
 * index listed all 73 posts in three languages interleaved by date.
 *
 * Shape is a magazine contents page rather than a feed: the newest piece is
 * given room, and the archive behind it is a ruled list grouped by month. As
 * a stack of identical cards, twenty-six posts had no hierarchy and no way to
 * scan — you could only scroll and hope.
 */
import { getCollection } from "astro:content";
import { useTranslations } from "../i18n/utils";
import type { Locale } from "../i18n/translations";

interface Props { lang?: Locale; }
const lang = (Astro.props.lang ?? "en") as Locale;
const t = useTranslations(lang);

const localeOf = (id: string): Locale =>
  id.startsWith("es-") ? "es" : id.startsWith("it-") ? "it" : "en";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft && localeOf(post.id) === lang)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const dateLocale = lang === "es" ? "es-ES" : lang === "it" ? "it-IT" : "en-US";
const fullDate = (d: Date) =>
  d.toLocaleDateString(dateLocale, { year: "numeric", month: "long", day: "numeric" });

const [featured, ...archive] = posts;

// Group the archive by month so the list has a pulse instead of running flat
// for twenty-five rows.
const groups: { label: string; posts: typeof archive }[] = [];
for (const post of archive) {
  const label = post.data.date.toLocaleDateString(dateLocale, { month: "long", year: "numeric" });
  const last = groups[groups.length - 1];
  if (last && last.label === label) last.posts.push(post);
  else groups.push({ label, posts: [post] });
}
---

<main class="bg-golden-hour min-h-screen pt-32 pb-24 px-6">
  <div class="max-w-3xl mx-auto">
    <header class="text-center mb-16 fade-up">
      <h1 class="font-wander text-4xl sm:text-5xl text-earth mb-3">{t("blog.title")}</h1>
      <p class="text-taupe text-lg">{t("blog.subtitle")}</p>
    </header>

    {featured && (
      <a href={`/blog/${featured.id}/`} class="featured paper block px-7 py-10 sm:px-12 sm:py-12 mb-20 fade-up fade-up-d2">
        <time class="doc-eyebrow">{fullDate(featured.data.date)}</time>
        <h2 class="featured-title font-wander text-2xl sm:text-[2rem] text-earth mt-4 mb-4 leading-[1.2]">
          {featured.data.title}
        </h2>
        <p class="text-cocoa/85 leading-relaxed mb-5">{featured.data.description}</p>
        <span class="text-sm font-medium text-ink">{t("blog.read")} &rarr;</span>
      </a>
    )}

    {groups.map((group, gi) => (
      <section class="mb-14 fade-up" style={`animation-delay: ${0.3 + gi * 0.05}s;`}>
        <h2 class="group-label doc-eyebrow">{group.label}</h2>
        <ul class="entries">
          {group.posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`} class="entry">
                <span class="entry-day">
                  {post.data.date.toLocaleDateString(dateLocale, { day: "2-digit" })}
                </span>
                <span>
                  <span class="entry-title font-wander">{post.data.title}</span>
                  <span class="entry-excerpt">{post.data.description}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    {posts.length === 0 && (
      <div class="text-center py-20">
        <p class="font-dear text-2xl text-taupe" style="font-style: italic;">
          {t("blog.comingSoon")}
        </p>
      </div>
    )}
  </div>
</main>

<style>
  .featured {
    text-decoration: none;
    transition: box-shadow 0.6s, transform 0.6s;
  }
  .featured:hover {
    box-shadow:
      0 1px 2px rgba(60, 42, 30, 0.05),
      0 20px 56px -16px rgba(60, 42, 30, 0.22);
  }
  .featured-title {
    transition: color 0.5s;
  }
  .featured:hover .featured-title {
    color: var(--color-cocoa);
  }

  .group-label {
    /* Localised month names come back lowercase in es and it. */
    text-transform: uppercase;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(244, 179, 125, 0.5);
  }

  .entries {
    list-style: none;
  }
  .entries li + li {
    border-top: 1px solid rgba(244, 179, 125, 0.28);
  }

  .entry {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 0.5rem;
    align-items: baseline;
    padding: 1.4rem 0.75rem 1.4rem 0;
    text-decoration: none;
    border-radius: 2px;
    transition: background-color 0.45s, padding-left 0.45s;
  }
  .entry:hover {
    background: rgba(255, 248, 240, 0.4);
    padding-left: 0.75rem;
  }

  .entry-day {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    /* Not --color-breath: this is a date, and amber on the golden ground is
       1.7:1. Decorative marks can take that, information can't. */
    color: var(--color-taupe);
  }

  .entry-title {
    display: block;
    font-size: 1.1875rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-earth);
    transition: color 0.45s;
  }
  .entry:hover .entry-title {
    color: var(--color-ink);
  }

  .entry-excerpt {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-taupe);
    /* One line of promise, not a second paragraph. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .entry {
      grid-template-columns: 2.25rem 1fr;
      padding: 1.15rem 0;
    }
    .entry-title {
      font-size: 1.0625rem;
    }
  }
</style>
