---
/**
 * The Journal index, one language at a time.
 *
 * Posts carry their language as a slug prefix (es-…, it-…) rather than living
 * under a locale route, so filtering happens on that prefix. Without it the
 * index listed all 73 posts in three languages interleaved by date.
 */
import { getCollection } from "astro:content";
import { useTranslations } from "../i18n/utils";
import type { Locale } from "../i18n/translations";

interface Props { lang?: Locale; }
const lang = (Astro.props.lang ?? "en") as Locale;
const t = useTranslations(lang);

const localeOf = (id: string): Locale =>
  id.startsWith("es-") ? "es" : id.startsWith("it-") ? "it" : "en";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft && localeOf(post.id) === lang)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const dateLocale = lang === "es" ? "es-ES" : lang === "it" ? "it-IT" : "en-US";
---

<main class="bg-golden-hour min-h-screen pt-32 pb-20 px-6">
  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-16 fade-up">
      <h1 class="font-wander text-4xl sm:text-5xl text-earth mb-4">{t("blog.title")}</h1>
      <p class="text-taupe text-lg">{t("blog.subtitle")}</p>
    </div>

    <div class="space-y-8">
      {posts.map((post, i) => (
        <article class="glass p-8 sm:p-10 fade-up group" style={`animation-delay: ${0.1 + i * 0.12}s;`}>
          <time class="doc-eyebrow">
            {post.data.date.toLocaleDateString(dateLocale, { year: "numeric", month: "long", day: "numeric" })}
          </time>
          <h2 class="font-wander text-xl sm:text-2xl text-earth mt-3 mb-3 leading-snug">
            <a href={`/blog/${post.id}/`} class="hover:text-cocoa transition-colors duration-500">
              {post.data.title}
            </a>
          </h2>
          <p class="text-cocoa/85 leading-relaxed mb-4">
            {post.data.description}
          </p>
          <a
            href={`/blog/${post.id}/`}
            class="text-sm font-medium text-ink hover:text-earth transition-colors duration-500"
          >
            {t("blog.read")} &rarr;
          </a>
        </article>
      ))}
    </div>

    {posts.length === 0 && (
      <div class="text-center py-20">
        <p class="font-dear text-2xl text-taupe" style="font-style: italic;">
          {t("blog.comingSoon")}
        </p>
      </div>
    )}
  </div>
</main>
