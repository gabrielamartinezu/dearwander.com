---
import { useTranslations } from "../i18n/utils";
import type { Locale } from "../i18n/translations";

interface Props { lang?: Locale; }
const lang = (Astro.props.lang ?? "en") as Locale;
const t = useTranslations(lang);

const posts = [
  { titleKey: "blog.post1.title" as const, excerptKey: "blog.post1.excerpt" as const, slug: "#" },
  { titleKey: "blog.post2.title" as const, excerptKey: "blog.post2.excerpt" as const, slug: "#" },
  { titleKey: "blog.post3.title" as const, excerptKey: "blog.post3.excerpt" as const, slug: "#" },
];
---

<section class="relative py-28 sm:py-36 px-6 bg-golden-hour" id="journal">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-16 reveal">
      <h2 class="font-wander text-3xl sm:text-4xl text-earth mb-3">{t("blog.title")}</h2>
      <p class="text-taupe font-light text-lg">{t("blog.subtitle")}</p>
    </div>

    <div class="grid sm:grid-cols-3 gap-6 sm:gap-8">
      {posts.map((post, i) => (
        <article
          class="glass p-8 flex flex-col reveal group cursor-pointer hover:shadow-lg hover:shadow-earth/8 transition-shadow duration-700"
          style={`transition-delay: ${0.1 + i * 0.15}s;`}
        >
          <p class="text-xs text-taupe/70 font-medium uppercase tracking-widest mb-4">{t("blog.comingSoon")}</p>
          <h3 class="font-wander text-lg text-earth mb-3 leading-snug group-hover:text-cocoa transition-colors duration-500">
            {t(post.titleKey)}
          </h3>
          <p class="text-sm text-cocoa/75 font-light leading-relaxed flex-1">
            {t(post.excerptKey)}
          </p>
          <span class="inline-block mt-5 text-sm font-medium text-breath group-hover:text-earth transition-colors duration-500">
            {t("blog.read")} &rarr;
          </span>
        </article>
      ))}
    </div>
  </div>
</section>
