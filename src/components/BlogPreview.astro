---
const posts = [
  {
    title: "Why your screen time app shouldn't feel like a punishment",
    excerpt: "The difference between blocking and pausing — and why the apps that scold you don't work.",
    date: "Coming soon",
    slug: "#",
  },
  {
    title: "The science of the 60-second pause",
    excerpt: "What happens in your brain when you breathe before you scroll. A look at the research behind Dear Wander.",
    date: "Coming soon",
    slug: "#",
  },
  {
    title: "Golden Hour: designing an app you want to open",
    excerpt: "How we built an intervention that feels like a gift — the design philosophy behind Dear Wander.",
    date: "Coming soon",
    slug: "#",
  },
];
---

<section class="relative py-28 sm:py-36 px-6 bg-golden-hour" id="journal">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-16 reveal">
      <h2 class="font-wander text-3xl sm:text-4xl text-earth mb-3">The Journal</h2>
      <p class="text-taupe font-light text-lg">Letters on attention, presence, and the phones we carry.</p>
    </div>

    <div class="grid sm:grid-cols-3 gap-6 sm:gap-8">
      {posts.map((post, i) => (
        <article
          class="glass p-8 flex flex-col reveal group cursor-pointer hover:shadow-lg hover:shadow-earth/8 transition-shadow duration-700"
          style={`transition-delay: ${0.1 + i * 0.15}s;`}
        >
          <p class="text-xs text-taupe/70 font-medium uppercase tracking-widest mb-4">{post.date}</p>
          <h3 class="font-wander text-lg text-earth mb-3 leading-snug group-hover:text-cocoa transition-colors duration-500">
            {post.title}
          </h3>
          <p class="text-sm text-cocoa/75 font-light leading-relaxed flex-1">
            {post.excerpt}
          </p>
          <span class="inline-block mt-5 text-sm font-medium text-breath group-hover:text-earth transition-colors duration-500">
            Read &rarr;
          </span>
        </article>
      ))}
    </div>
  </div>
</section>
