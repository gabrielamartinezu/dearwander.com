---
import { getCollection } from "astro:content";

interface Props {
  currentSlug: string;
  tags?: string[];
}

const { currentSlug, tags = [] } = Astro.props;

const allPosts = await getCollection("blog");

// Score posts by shared tags, exclude current
const scored = allPosts
  .filter((p) => p.id !== currentSlug && !p.data.draft)
  .map((p) => {
    const shared = (p.data.tags ?? []).filter((t: string) => tags.includes(t)).length;
    return { post: p, score: shared };
  })
  .sort((a, b) => b.score - a.score || b.post.data.date.getTime() - a.post.data.date.getTime())
  .slice(0, 3);
---

{scored.length > 0 && (
  <div class="related">
    <p class="related-title">Keep reading</p>
    <div class="related-grid">
      {scored.map(({ post }) => (
        <a href={`/blog/${post.id}/`} class="glass related-card">
          <p class="related-date">
            {post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
          </p>
          <h3 class="related-heading">{post.data.title}</h3>
          <p class="related-excerpt">{post.data.description}</p>
        </a>
      ))}
    </div>
  </div>
)}

<style>
  .related {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(244, 179, 125, 0.3);
  }
  .related-title {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--color-taupe);
    margin-bottom: 1.25rem;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }
  .related-card {
    padding: 1.25rem;
    text-decoration: none;
    transition: box-shadow 0.5s;
  }
  .related-card:hover {
    box-shadow: 0 8px 24px rgba(60, 42, 30, 0.1);
  }
  .related-date {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-taupe);
    opacity: 0.7;
    margin-bottom: 0.5rem;
  }
  .related-heading {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-earth);
    line-height: 1.4;
    margin-bottom: 0.5rem;
  }
  .related-excerpt {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 300;
    color: var(--color-cocoa);
    opacity: 0.75;
    line-height: 1.55;
  }
</style>
