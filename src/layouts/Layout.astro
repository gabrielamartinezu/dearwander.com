---

// Token del beacon de Cloudflare Web Analytics. Vacío = no se carga nada.
// No es un secreto: acaba en el HTML de todas formas.
const CF_BEACON = "15c45c2b2c154c4fa3995721a7ef9510";
import "../styles/global.css";
import { getLangFromUrl, getLocalePath } from "../i18n/utils";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  isArticle?: boolean;
  articleDate?: string;
  articleModified?: string;
}

const lang = getLangFromUrl(Astro.url);

const {
  title = "Dear Wander — Mindful Screen Time",
  description = "Sixty seconds back to yourself. Dear Wander intercepts your scroll with a moment of beauty — guided breathing before you open social media. Coming soon to iOS.",
  ogImage = "/og-image.jpg",
  isArticle = false,
  articleDate,
  articleModified,
  // Solo las rutas de blog las pasan; el resto del sitio deduce sus versiones
  // quitando el prefijo del idioma a la ruta.
  alternates = [],
} = Astro.props;

// Every self-referencing URL must use the trailing-slash form, or /page and
// /page/ each canonicalize to themselves and Google keeps them as two pages.
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);

const canonicalURL = new URL(withSlash(Astro.url.pathname), Astro.site);
const siteURL = Astro.site?.origin ?? "https://dearwander.com";

// Build hreflang path: strip locale prefix to get the base path
const pathname = Astro.url.pathname;
const basePath = withSlash(pathname.replace(/^\/(es|it)/, "") || "/");

// Blog posts use prefix-in-slug pattern (es-slug, it-slug) not locale routing (/es/blog/slug)
// Only output hreflang for pages that use locale-prefixed routes (homepage, main pages)
const isBlogPost = pathname.match(/^\/blog\/.+/);
const isTranslatedBlogPost = pathname.match(/^\/blog\/(es|it)-/);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Los posts traducidos traen sus alternativas calculadas en la ruta,
         porque su patron de URL es /blog/es-slug y no /es/blog/slug. -->
    {isBlogPost && alternates.length > 0 && (
      <>
        {alternates.map((a) => (
          <link rel="alternate" hreflang={a.lang} href={`${siteURL}/blog/${a.id}/`} />
        ))}
        <link rel="alternate" hreflang="x-default"
              href={`${siteURL}/blog/${(alternates.find((a) => a.lang === "en") ?? alternates[0]).id}/`} />
      </>
    )}

    <!-- hreflang para el resto del sitio, que si usa rutas con prefijo -->
    {!isBlogPost && (
      <>
        <link rel="alternate" hreflang="en" href={`${siteURL}${basePath}`} />
        <link rel="alternate" hreflang="es" href={`${siteURL}/es${basePath}`} />
        <link rel="alternate" hreflang="it" href={`${siteURL}/it${basePath}`} />
        <link rel="alternate" hreflang="x-default" href={`${siteURL}${basePath}`} />
      </>
    )}

    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&family=Nunito:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="mindful screen time, reduce screen time, doomscrolling, phone addiction, digital detox, screen time app, iOS, mindfulness" />
    <meta name="author" content="Dear Wander" />

    <!-- Pinterest domain verification -->
    <meta name="p:domain_verify" content="94c379c6294e8567d3da708412a2e2c8"/>

    <!-- Google Search Console -->
    <meta name="google-site-verification" content="G0bn3YeX4B3HxI-OWbOPm8RXH0O2djpT-WpNpmftz-k"/>

    <!-- Bing Webmaster Tools -->
    <meta name="msvalidate.01" content="033796ECF15D4E29B780114899AD58B4"/>

    <!-- Open Graph -->
    <meta property="og:type" content={isArticle ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteURL}${ogImage}`} />
    <meta property="og:site_name" content="Dear Wander" />
    <meta property="og:locale" content={lang === "es" ? "es_ES" : lang === "it" ? "it_IT" : "en_US"} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteURL}${ogImage}`} />

    <!-- Theme -->
    <meta name="theme-color" content="#F4B37D" />
    <meta name="msapplication-TileColor" content="#F4B37D" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Schema: Organization + WebSite (all pages) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": `${siteURL}/#organization`,
          "name": "Dear Wander",
          "url": siteURL,
          "logo": `${siteURL}/icon.png`,
          "sameAs": [
            "https://instagram.com/dearwander.app",
            "https://www.youtube.com/@Dearwander_app",
            "https://tiktok.com/@dearwander.app"
          ]
        },
        {
          "@type": "WebSite",
          "@id": `${siteURL}/#website`,
          "name": "Dear Wander",
          "url": siteURL,
          "description": "Mindful screen time. Sixty seconds back to yourself.",
          "inLanguage": ["en", "es", "it"],
          "publisher": { "@id": `${siteURL}/#organization` }
        },
        {
          "@type": "SoftwareApplication",
          "name": "Dear Wander",
          "operatingSystem": "iOS",
          "applicationCategory": "HealthApplication",
          "description": "Mindful screen time app that intercepts your scroll with guided breathing before you open social media.",
          "offers": {
            "@type": "Offer",
            "availability": "https://schema.org/InStock",
            "price": "0",
            "priceCurrency": "USD"
          },
          "creator": { "@id": `${siteURL}/#organization` }
        },
        ...(isArticle ? [{
          "@type": "Article",
          "headline": title,
          "description": description,
          "author": { "@id": `${siteURL}/#organization` },
          "publisher": { "@id": `${siteURL}/#organization` },
          "datePublished": articleDate,
          "dateModified": articleModified ?? articleDate,
          "inLanguage": lang,
          "mainEntityOfPage": canonicalURL.toString()
        }] : [])
      ]
    })} />

    <!--
      Analítica de Cloudflare. Sin cookies, sin identificadores, sin datos
      personales: por eso no hace falta banner de consentimiento, que en un sitio
      que promete no rastrear sería una contradicción difícil de explicar.

      Existe para poder responder una pregunta que hoy no se puede: de dónde
      viene la gente. Search Console solo enseña Google y no dice nada de
      referencias, así que si ChatGPT o Perplexity citan el blog, ahora mismo
      no habría forma de saberlo.

      PARA ACTIVARLA: crea el sitio en Cloudflare > Web Analytics (gratis, no hace
      falta mover el DNS), copia el token del beacon y pégalo abajo. Mientras esté
      vacío no se carga nada.
    -->
    {CF_BEACON && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${CF_BEACON}"}`}
      />
    )}
  </head>
  <body class="grain">
    <slot />

    <script is:inline>
      // Propaga la etiqueta de campaña a los enlaces de descarga.
      //
      // Si alguien entra por dearwander.com/?from=ig-bio y luego pulsa
      // Descargar, sin esto la instalación se atribuiría a "web-hero" y
      // perderíamos de dónde vino. Así el enlace de la bio puede apuntar a
      // cualquier página del sitio sin renunciar a medir.
      (function () {
        const raw = new URLSearchParams(location.search).get("from");
        if (!raw) return;
        const from = raw.replace(/[^a-zA-Z0-9_-]/g, "").slice(0, 40);
        if (!from) return;
        document.querySelectorAll('a[href^="/app"]').forEach(function (a) {
          a.setAttribute("href", "/app?from=" + from);
        });
      })();
    </script>

    <script>
      // Scroll reveal observer
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
      );

      document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
    </script>

    <script is:inline>
      // First-touch attribution. Capture where the visitor came from on their
      // FIRST page of the session and keep it, so a newsletter signup three
      // clicks later still knows the original source (Instagram, Google, etc.).
      (function () {
        try {
          if (sessionStorage.getItem("dw_attribution")) return;
          var params = new URLSearchParams(window.location.search);
          var ref = document.referrer;
          try {
            if (ref && new URL(ref).hostname === window.location.hostname) ref = "";
          } catch (e) {}
          sessionStorage.setItem(
            "dw_attribution",
            JSON.stringify({
              utm_source: params.get("utm_source") || "",
              utm_medium: params.get("utm_medium") || "",
              utm_campaign: params.get("utm_campaign") || "",
              referrer: ref || (params.get("utm_source") ? "" : "direct"),
              landing_page: window.location.pathname,
            })
          );
        } catch (e) {}
      })();
    </script>
  </body>
</html>
