---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Hero from "../../components/Hero.astro";
import Features from "../../components/Features.astro";
import CreatorNote from "../../components/CreatorNote.astro";
import BlogPreview from "../../components/BlogPreview.astro";
import FAQ from "../../components/FAQ.astro";
import ClosingCTA from "../../components/ClosingCTA.astro";
import Footer from "../../components/Footer.astro";

const lang = "es";
---

<Layout
  title="Dear Wander — Uso Consciente del Móvil"
  description="Sesenta segundos para volver a ti. Dear Wander intercepta tu scroll con un momento de belleza — respiración guiada antes de abrir redes sociales. Próximamente en iOS."
>
  <Header lang={lang} />
  <main>
    <Hero lang={lang} />
    <Features lang={lang} />
    <CreatorNote lang={lang} />
    <BlogPreview lang={lang} />
    <FAQ lang={lang} />
    <ClosingCTA lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
