---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AppStoreButton from "../components/AppStoreButton.astro";

const faqs = [
  { q: "How much screen time is too much?", a: "There's no single magic number. Researchers often point to keeping recreational social media under 30 to 60 minutes a day, but what matters more is whether the time feels chosen or automatic. The average person spends about 5 hours a day on their phone and picks it up around 144 times." },
  { q: "Is screen time actually bad for you?", a: "Screen time itself isn't the problem. Passive, compulsive scrolling is. Research links long passive scrolling sessions with increased anxiety and disrupted sleep, while intentional use (maps, messages, learning) is generally fine. The goal isn't zero. It's choosing." },
  { q: "How do I reduce my screen time without willpower?", a: "Willpower runs out. Small changes to your environment last longer: charge your phone outside the bedroom, turn off non-essential notifications, and add a brief pause before opening the apps that pull you in. A 60-second breathing pause before social media reduced usage by 57% in one University of Heidelberg study." },
  { q: "How many years of your life are spent on a smartphone?", a: "At the average of 4 to 5 hours a day, a person will spend 8 to 12 entire years of their waking adult life looking at a screen. Reclaiming just one hour each day returns over 2 full years of conscious waking life." },
];

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Screen Time Calculator",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "All",
    "url": "https://dearwander.com/screen-time-calculator/",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "description": "Calculate how much of your waking life is spent on your phone and how many years you can reclaim."
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a },
    })),
  }
];
---

<Layout
  title="Screen Time Calculator: How Many Years of Your Life Do You Spend on Your Phone?"
  description="Calculate how much of your life you spend on your phone (weeks, years, and waking life). See how much waking life you can reclaim without willpower."
>
  <script type="application/ld+json" set:html={JSON.stringify(schemas)} />

  <Header lang="en" lightBg={true} />

  <main class="bg-golden-hour min-h-screen pt-28 pb-20 px-6">

    <!-- Hero -->
    <section class="max-w-xl mx-auto text-center pt-10 pb-10">
      <p class="text-xs font-medium uppercase tracking-[0.2em] text-taupe/60 mb-6 fade-up">
        Free tool · No sign-up required · No guilt
      </p>
      <h1 class="font-wander text-4xl sm:text-5xl text-earth mb-5 leading-tight fade-up fade-up-d1">
        Screen Time Calculator
      </h1>
      <p class="text-lg text-cocoa/75 font-light leading-relaxed max-w-md mx-auto fade-up fade-up-d2">
        See where your phone time goes, gently. No shame reports or "you wasted" lectures. Just a clear perspective on your life and what you could reclaim.
      </p>
    </section>

    <!-- Calculator -->
    <section class="max-w-lg mx-auto pb-12">
      <div class="glass p-8 sm:p-10 fade-up fade-up-d3">

        <label for="hours" class="block text-sm font-medium text-earth mb-1">Hours a day on your phone</label>
        <p class="text-xs text-taupe/60 mb-4">A rough guess is perfect. (On iPhone: Settings → Screen Time).</p>
        <input id="hours" type="range" min="1" max="12" step="0.5" value="4"
          class="w-full accent-[color:var(--color-breath,#E8B86D)] cursor-pointer" />
        <div class="flex justify-between text-xs text-taupe/50 mt-1 mb-8">
          <span>1h</span><span>4h (average)</span><span>12h</span>
        </div>

        <!-- Live output -->
        <div class="text-center">
          <p class="text-cocoa/70 font-light mb-2">
            <span id="hoursLabel" class="font-semibold text-earth text-lg">4</span> hours a day equals:
          </p>

          <div class="grid grid-cols-2 gap-3 my-4">
            <div class="bg-warm-white/50 rounded-xl p-3 border border-taupe/10">
              <p class="font-wander text-2xl text-earth" id="hoursWeek">28h</p>
              <p class="text-xs text-cocoa/60 font-light">a week</p>
            </div>
            <div class="bg-warm-white/50 rounded-xl p-3 border border-taupe/10">
              <p class="font-wander text-2xl text-earth"><span id="daysYear">61</span> days</p>
              <p class="text-xs text-cocoa/60 font-light">a year</p>
            </div>
          </div>

          <!-- Emotional Reframe: Lifetime Impact -->
          <div class="bg-earth text-warm-white rounded-2xl p-5 my-6 text-center shadow-lg shadow-earth/10">
            <p class="text-xs uppercase tracking-widest text-amber/80 font-medium mb-1">Across your adult lifetime</p>
            <p class="font-wander text-3xl sm:text-4xl text-warm-white mb-1">
              <span id="lifetimeYears" class="text-breath">8.3</span> years
            </p>
            <p class="text-xs text-warm-white/70 font-light max-w-xs mx-auto">
              of your conscious waking life spent on a screen (about <span id="wakingPercent" class="font-medium text-warm-white">25%</span> of your waking hours).
            </p>
          </div>

          <p class="text-cocoa/70 font-light text-sm mb-6">
            The global average is around 5 hours and 144 pickups a day, so you're
            <span id="vsAverage" class="font-medium text-earth">in good company</span>.
          </p>

          <!-- The Reframe -->
          <div class="bg-breath/15 rounded-2xl p-6 text-left">
            <p class="font-dear text-2xl text-earth mb-2" style="font-style: italic;">
              If you reclaim just 1 hour a day:
            </p>
            <p class="text-cocoa/80 font-light text-sm leading-relaxed">
              You gain <span id="reclaimDays" class="font-semibold text-earth">15 days</span> each year and <span id="reclaimLifetime" class="font-semibold text-earth">2.1 years</span> of conscious waking life back. Real time for deep rest, genuine connection, books, or peaceful silence.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Share -->
    <section class="max-w-md mx-auto text-center pb-12 fade-up">
      <button id="shareBtn"
        class="text-sm font-medium text-earth/70 hover:text-earth underline underline-offset-4 transition-colors cursor-pointer">
        Copy my result to share
      </button>
      <p id="shareConfirm" class="text-xs text-breath font-medium mt-2 opacity-0 transition-opacity">Copied to clipboard. Paste anywhere.</p>
    </section>

    <!-- Conversion Bridge to Dear Wander -->
    <section class="max-w-xl mx-auto text-center pb-16">
      <div class="glass p-8 sm:p-10">
        <p class="text-xs uppercase tracking-widest text-amber font-medium mb-3">The Self-Regulation Loop</p>
        <h2 class="font-wander text-3xl text-earth mb-4">Reclaim your time without fighting your willpower</h2>
        <p class="text-cocoa/75 font-light leading-relaxed mb-6">
          Hard blockers fail because willpower is a finite resource. Dear Wander closes your daily loop: <strong>Morning Intention</strong>, <strong>60-second breathing pause</strong> before opening addictive apps, and <strong>Evening Reflective Journaling</strong> to dissolve impulses at the root.
        </p>

        <div class="flex flex-col items-center justify-center gap-4">
          <AppStoreButton from="calculator-en" lang="en" size="lg" />

          <a
            href="/letters/"
            class="text-xs text-taupe hover:text-earth underline underline-offset-4 transition-colors mt-2 font-light"
          >
            Prefer to start with daily reflections? Read 7 Letters for a Gentler Phone Habit (Free)
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ (SEO + AI citability) -->
    <section class="max-w-2xl mx-auto pb-8">
      <h2 class="font-wander text-2xl text-earth text-center mb-8">Frequently asked questions about screen time</h2>
      <div class="space-y-4">
        {faqs.map((f) => (
          <details class="glass rounded-2xl px-6 py-5 group">
            <summary class="flex items-center justify-between cursor-pointer list-none font-wander text-lg text-earth">
              <span>{f.q}</span>
              <svg class="w-5 h-5 text-taupe shrink-0 ml-4 transition-transform duration-300 group-open:rotate-45" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
            </summary>
            <p class="text-cocoa/80 font-light leading-relaxed mt-4">{f.a}</p>
          </details>
        ))}
      </div>
      <p class="text-center text-sm text-cocoa/60 font-light mt-8">
        Want to dive deeper? Read the <a href="/blog/phone-addiction-statistics-2026/" class="text-earth underline underline-offset-4">2026 smartphone addiction statistics</a> or explore <a href="/blog/science-of-the-60-second-pause/" class="text-earth underline underline-offset-4">the science of the 60-second pause</a>.
      </p>
    </section>
  </main>

  <Footer lang="en" />

  <style>
    details summary::-webkit-details-marker { display: none; }
  </style>

  <script is:inline>
    (function () {
      const hours = document.getElementById("hours");
      const hoursLabel = document.getElementById("hoursLabel");
      const hoursWeek = document.getElementById("hoursWeek");
      const daysYear = document.getElementById("daysYear");
      const lifetimeYears = document.getElementById("lifetimeYears");
      const wakingPercent = document.getElementById("wakingPercent");
      const reclaimDays = document.getElementById("reclaimDays");
      const reclaimLifetime = document.getElementById("reclaimLifetime");
      const vsAverage = document.getElementById("vsAverage");
      const shareBtn = document.getElementById("shareBtn");
      const shareConfirm = document.getElementById("shareConfirm");

      function fmt(n) { return Number.isInteger(n) ? n.toString() : n.toFixed(1); }

      function update() {
        const h = parseFloat(hours.value);
        hoursLabel.textContent = fmt(h);
        hoursWeek.textContent = Math.round(h * 7) + "h";
        daysYear.textContent = Math.round((h * 365) / 24);

        // Assuming 16 waking hours per day and 50 years of adult life
        const pct = Math.round((h / 16) * 100);
        wakingPercent.textContent = pct + "%";

        const lifeYears = ((h / 16) * 50).toFixed(1);
        lifetimeYears.textContent = lifeYears;

        const reclaimable = Math.min(1, h);
        reclaimDays.textContent = Math.round((reclaimable * 365) / 24) + " days";
        const reclaimedLife = ((reclaimable / 16) * 50).toFixed(1);
        reclaimLifetime.textContent = reclaimedLife + " years";

        if (h < 4) vsAverage.textContent = "below the average";
        else if (h < 6) vsAverage.textContent = "right around the global average (5h)";
        else vsAverage.textContent = "above the average";
      }

      hours.addEventListener("input", update);
      update();

      shareBtn.addEventListener("click", function () {
        const h = hoursLabel.textContent;
        const ly = lifetimeYears.textContent;
        const text = "At " + h + "h a day, I'll spend " + ly + " years of my waking adult life on my phone. Calculate yours at dearwander.com/screen-time-calculator/ 🌅";
        navigator.clipboard.writeText(text).then(function () {
          shareConfirm.style.opacity = "1";
          setTimeout(function () { shareConfirm.style.opacity = "0"; }, 2500);
        });
      });
    })();
  </script>
</Layout>

