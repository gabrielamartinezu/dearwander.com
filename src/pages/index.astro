---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import CreatorNote from "../components/CreatorNote.astro";
import BlogPreview from "../components/BlogPreview.astro";
import FAQ from "../components/FAQ.astro";
import ClosingCTA from "../components/ClosingCTA.astro";
import Footer from "../components/Footer.astro";

const lang = "en";
---

<Layout
  title="Dear Wander: Mindful Screen Time App for iPhone"
  description="Sixty seconds back to yourself. Dear Wander meets your scroll with a moment of guided breathing before social media opens. Free on iPhone, no account."
>
  <Header lang={lang} />
  <main>
    <Hero lang={lang} />
    <Features lang={lang} />
    <CreatorNote lang={lang} />
    <BlogPreview lang={lang} />
    <FAQ lang={lang} />
    <ClosingCTA lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
