---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import AuthorBio from "../../components/AuthorBio.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import YouTubeLite from "../../components/YouTubeLite.astro";
import BlogCTA from "../../components/BlogCTA.astro";
import { getCollection, render } from "astro:content";
import { useTranslations, getLocalePath } from "../../i18n/utils";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const ids = new Set(posts.map((p) => p.id));

  // Las traducciones no viven en /es/blog/ sino en el mismo directorio con el
  // slug prefijado (es-foo, it-foo). Por eso el layout no puede deducirlas
  // quitando el prefijo de la ruta, como hace con el resto del sitio, y hay
  // que calcularlas aqui.
  //
  // Solo se emiten las que EXISTEN: apuntar un hreflang a una URL que da 404
  // es peor que no poner ninguno.
  return posts.map((post) => {
    const base = post.id.replace(/^(es|it)-/, "");
    const alternates = [
      ids.has(base) ? { lang: "en", id: base } : null,
      ids.has(`es-${base}`) ? { lang: "es", id: `es-${base}` } : null,
      ids.has(`it-${base}`) ? { lang: "it", id: `it-${base}` } : null,
    ].filter(Boolean);
    return {
      params: { id: post.id },
      props: { post, alternates: alternates.length > 1 ? alternates : [] },
    };
  });
}

const { post, alternates } = Astro.props;

// Qué meditación acompaña a cada post. Se declara aquí y no dentro del markdown
// porque la colección solo carga .md, que no admite componentes, y porque así
// la colocación es un dato editable de un vistazo en vez de marcado enterrado
// en la prosa.
//
// Va incrustado y no enlazado a propósito: un enlace saca a la persona del
// sitio, y el canal todavía no puede devolverla porque los enlaces en las
// descripciones están bloqueados hasta que cumpla dos meses.
const VIDEOS: Record<string, { id: string; titulo: string; duracion: string }> = {
  "es-vagus-nerve-breathing": {
    id: "Kqem8DyhgHQ",
    titulo: "Meditación guiada para la ansiedad y sobrepensar",
    duracion: "10 min",
  },
  "es-guided-imagery-meditation": {
    id: "KaR9K-uilFA",
    titulo: "Meditación guiada para dormir profundamente, con lluvia",
    duracion: "11 min",
  },
  "es-revenge-bedtime-scrolling": {
    id: "KaR9K-uilFA",
    titulo: "Meditación guiada para dormir profundamente, con lluvia",
    duracion: "11 min",
  },
  "es-adhd-doomscrolling": {
    id: "Kqem8DyhgHQ",
    titulo: "Meditación guiada para calmar la mente y dejar de sobrepensar",
    duracion: "10 min",
  },
  "es-popcorn-brain": {
    id: "Kqem8DyhgHQ",
    titulo: "Meditación guiada para calmar la mente",
    duracion: "10 min",
  },
};
const video = VIDEOS[post.id];
const { Content, headings } = await render(post);

// Detect language from the slug prefix (es-*, it-*) for localized chrome
const postLang = post.id.startsWith("es-") ? "es" : post.id.startsWith("it-") ? "it" : "en";

const rawBody = post.body ?? "";
const wordCount = rawBody.split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 200));

const dateLocale = postLang === "es" ? "es-ES" : postLang === "it" ? "it-IT" : "en-US";
const formattedDate = post.data.date.toLocaleDateString(dateLocale, { year: "numeric", month: "long", day: "numeric" });

const readTimeLabel = postLang === "es" 
  ? `${readingMinutes} min de lectura` 
  : postLang === "it" 
  ? `${readingMinutes} min di lettura` 
  : `${readingMinutes} min read`;

const authorLabel = postLang === "es"
  ? "Por Gabriela Martínez"
  : postLang === "it"
  ? "Di Gabriela Martínez"
  : "By Gabriela Martínez";

const h2Headings = headings.filter((h) => h.depth === 2);

const siteURL = "https://dearwander.com";
const postURL = `${siteURL}/blog/${post.id}/`;

// BreadcrumbList schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteURL },
    { "@type": "ListItem", "position": 2, "name": "Journal", "item": `${siteURL}/blog/` },
    { "@type": "ListItem", "position": 3, "name": post.data.title, "item": postURL },
  ],
};

// FAQ schema (if post has FAQ data)
const faqSchema = post.data.faq?.length ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": post.data.faq.map((item: { q: string; a: string }) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a },
  })),
} : null;
---

<Layout
  title={`${post.data.title} — Dear Wander`}
  description={post.data.description}
  isArticle={true}
  articleDate={post.data.date.toISOString()}
  alternates={alternates}
>
  <!-- Reading progress bar -->
  <div id="reading-progress-bar" class="fixed top-0 left-0 h-1 bg-gradient-to-r from-amber via-breath to-earth z-[60] transition-all duration-75" style="width: 0%;"></div>

  <Header lightBg={true} />

  <!-- BreadcrumbList schema -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}

  <main class="bg-golden-hour min-h-screen pt-32 pb-20 px-6">
    <article class="max-w-[44rem] mx-auto">
      <!-- Header -->
      <div class="text-center mb-12 fade-up">
        <div class="inline-flex flex-wrap items-center justify-center gap-2 text-xs text-taupe/80 font-sans tracking-wide uppercase mb-4">
          <time class="font-semibold text-earth/80">{formattedDate}</time>
          <span class="text-amber">•</span>
          <span class="font-medium text-cocoa/75">{readTimeLabel}</span>
          <span class="text-amber">•</span>
          <a href="/about" class="text-taupe hover:text-earth underline underline-offset-2 transition-colors font-medium">
            {authorLabel}
          </a>
        </div>

        <h1 class="font-wander text-3xl sm:text-4xl md:text-5xl text-earth mt-2 mb-5 leading-[1.15]">
          {post.data.title}
        </h1>

        <p class="font-dear text-xl sm:text-2xl text-taupe leading-snug max-w-xl mx-auto mb-6">
          {post.data.description}
        </p>

        <!-- Quick Share button -->
        <div class="flex items-center justify-center gap-3">
          <button
            id="copyPostLinkBtn"
            data-copied-text={postLang === "es" ? "✓ ¡Enlace copiado!" : postLang === "it" ? "✓ Link copiato!" : "✓ Link copied!"}
            class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full bg-warm-white/70 border border-amber/30 text-xs font-medium text-cocoa/80 hover:text-earth hover:border-breath hover:bg-warm-white transition-all cursor-pointer shadow-sm"
          >
            <svg class="w-3.5 h-3.5 text-taupe" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
            <span id="copyPostLinkText">{postLang === "es" ? "Copiar enlace" : postLang === "it" ? "Copia link" : "Copy link"}</span>
          </button>
        </div>
      </div>

      <!-- Content -->
      <div class="paper px-7 py-10 sm:px-12 sm:py-14 fade-up fade-up-d2">
        {h2Headings.length >= 3 && (
          <details class="mb-10 p-5 sm:p-6 rounded-2xl bg-golden-start/20 border border-amber/25 group transition-all">
            <summary class="flex items-center justify-between cursor-pointer list-none text-xs font-semibold uppercase tracking-widest text-earth/80 hover:text-earth transition-colors">
              <span class="flex items-center gap-2">
                <svg class="w-4 h-4 text-breath" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/></svg>
                {postLang === "es" ? "En este artículo" : postLang === "it" ? "In questo articolo" : "In this article"} ({h2Headings.length})
              </span>
              <svg class="w-4 h-4 text-taupe transition-transform duration-300 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <ol class="mt-4 space-y-2.5 text-sm font-sans list-decimal list-inside pl-1 text-cocoa/85 border-t border-amber/15 pt-3">
              {h2Headings.map((h) => (
                <li class="hover:text-earth transition-colors">
                  <a href={`#${h.slug}`} class="no-underline hover:underline text-cocoa hover:text-earth">{h.text}</a>
                </li>
              ))}
            </ol>
          </details>
        )}

        <div class="prose prose-article">
          <Content />
        </div>

        <BlogCTA lang={postLang} />

        {video && (
          <div class="mt-10 pt-8 border-t border-earth/10">
            <p class="text-sm text-taupe mb-3">Para practicarlo:</p>
            <YouTubeLite id={video.id} titulo={video.titulo} duracion={video.duracion} />
          </div>
        )}
      </div>

      <!-- Author -->
      <AuthorBio lang={postLang} />

      <!-- Related posts -->
      <RelatedPosts currentSlug={post.id} tags={post.data.tags} lang={postLang} />

      <!-- Back — to the index in this post's language, not always the English one -->
      <div class="mt-12 text-center fade-up fade-up-d3">
        <a
          href={getLocalePath(postLang, "/blog/")}
          class="text-sm font-medium text-ink hover:text-earth transition-colors duration-500"
        >
          &larr; {useTranslations(postLang)("blog.backToJournal")}
        </a>
      </div>
    </article>
  </main>

  <Footer lang={postLang} />

  <script is:inline>
    (function () {
      const bar = document.getElementById("reading-progress-bar");
      function updateProgress() {
        if (!bar) return;
        const scrollY = window.scrollY || document.documentElement.scrollTop;
        const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
        const percent = scrollHeight > 0 ? Math.min(100, Math.max(0, (scrollY / scrollHeight) * 100)) : 0;
        bar.style.width = percent + "%";
      }
      window.addEventListener("scroll", updateProgress, { passive: true });
      updateProgress();

      const copyBtn = document.getElementById("copyPostLinkBtn");
      const copyText = document.getElementById("copyPostLinkText");
      if (copyBtn && copyText) {
        const originalText = copyText.textContent;
        copyBtn.addEventListener("click", function () {
          navigator.clipboard.writeText(window.location.href).then(function () {
            copyText.textContent = copyBtn.dataset.copiedText || "✓ Copiado";
            setTimeout(function () {
              copyText.textContent = originalText;
            }, 2000);
          });
        });
      }
    })();
  </script>
</Layout>


<!-- Prose styling lives in global.css. This page used to carry a scoped copy,
     which drifted out of sync with it — the list-marker bug had to be fixed in
     both places before they were merged. Don't reintroduce one. -->
