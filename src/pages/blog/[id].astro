---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import AuthorBio from "../../components/AuthorBio.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import YouTubeLite from "../../components/YouTubeLite.astro";
import { getCollection, render } from "astro:content";
import { useTranslations, getLocalePath } from "../../i18n/utils";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const ids = new Set(posts.map((p) => p.id));

  // Las traducciones no viven en /es/blog/ sino en el mismo directorio con el
  // slug prefijado (es-foo, it-foo). Por eso el layout no puede deducirlas
  // quitando el prefijo de la ruta, como hace con el resto del sitio, y hay
  // que calcularlas aqui.
  //
  // Solo se emiten las que EXISTEN: apuntar un hreflang a una URL que da 404
  // es peor que no poner ninguno.
  return posts.map((post) => {
    const base = post.id.replace(/^(es|it)-/, "");
    const alternates = [
      ids.has(base) ? { lang: "en", id: base } : null,
      ids.has(`es-${base}`) ? { lang: "es", id: `es-${base}` } : null,
      ids.has(`it-${base}`) ? { lang: "it", id: `it-${base}` } : null,
    ].filter(Boolean);
    return {
      params: { id: post.id },
      props: { post, alternates: alternates.length > 1 ? alternates : [] },
    };
  });
}

const { post, alternates } = Astro.props;

// Qué meditación acompaña a cada post. Se declara aquí y no dentro del markdown
// porque la colección solo carga .md, que no admite componentes, y porque así
// la colocación es un dato editable de un vistazo en vez de marcado enterrado
// en la prosa.
//
// Va incrustado y no enlazado a propósito: un enlace saca a la persona del
// sitio, y el canal todavía no puede devolverla porque los enlaces en las
// descripciones están bloqueados hasta que cumpla dos meses.
const VIDEOS: Record<string, { id: string; titulo: string; duracion: string }> = {
  "es-vagus-nerve-breathing": {
    id: "Kqem8DyhgHQ",
    titulo: "Meditación guiada para la ansiedad",
    duracion: "11 min",
  },
  "es-guided-imagery-meditation": {
    id: "KaR9K-uilFA",
    titulo: "Meditación guiada para dormir, con lluvia",
    duracion: "11 min",
  },
  "es-revenge-bedtime-scrolling": {
    id: "KaR9K-uilFA",
    titulo: "Meditación guiada para dormir, con lluvia",
    duracion: "11 min",
  },
};
const video = VIDEOS[post.id];
const { Content } = await render(post);

// Detect language from the slug prefix (es-*, it-*) for localized chrome
const postLang = post.id.startsWith("es-") ? "es" : post.id.startsWith("it-") ? "it" : "en";

const siteURL = "https://dearwander.com";
const postURL = `${siteURL}/blog/${post.id}/`;

// BreadcrumbList schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteURL },
    { "@type": "ListItem", "position": 2, "name": "Journal", "item": `${siteURL}/blog/` },
    { "@type": "ListItem", "position": 3, "name": post.data.title, "item": postURL },
  ],
};

// FAQ schema (if post has FAQ data)
const faqSchema = post.data.faq?.length ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": post.data.faq.map((item: { q: string; a: string }) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a },
  })),
} : null;
---

<Layout
  title={`${post.data.title} — Dear Wander`}
  description={post.data.description}
  isArticle={true}
  articleDate={post.data.date.toISOString()}
  alternates={alternates}
>
  <Header lightBg={true} />

  <!-- BreadcrumbList schema -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}

  <main class="bg-golden-hour min-h-screen pt-32 pb-20 px-6">
    <article class="max-w-[44rem] mx-auto">
      <!-- Header -->
      <div class="text-center mb-12 fade-up">
        <time class="doc-eyebrow block">
          {post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
        </time>
        <h1 class="font-wander text-3xl sm:text-4xl md:text-5xl text-earth mt-5 mb-5 leading-[1.15]">
          {post.data.title}
        </h1>
        <p class="font-dear text-xl sm:text-2xl text-taupe leading-snug max-w-lg mx-auto">
          {post.data.description}
        </p>
      </div>

      <!-- Content -->
      <div class="paper px-7 py-10 sm:px-12 sm:py-14 fade-up fade-up-d2">
        <div class="prose prose-article">
          <Content />
        </div>

        {video && (
          <div class="mt-10 pt-8 border-t border-earth/10">
            <p class="text-sm text-taupe mb-3">Para practicarlo:</p>
            <YouTubeLite id={video.id} titulo={video.titulo} duracion={video.duracion} />
          </div>
        )}
      </div>

      <!-- Author -->
      <AuthorBio lang={postLang} />

      <!-- Related posts -->
      <RelatedPosts currentSlug={post.id} tags={post.data.tags} lang={postLang} />

      <!-- Back — to the index in this post's language, not always the English one -->
      <div class="mt-12 text-center fade-up fade-up-d3">
        <a
          href={getLocalePath(postLang, "/blog/")}
          class="text-sm font-medium text-ink hover:text-earth transition-colors duration-500"
        >
          &larr; {useTranslations(postLang)("blog.backToJournal")}
        </a>
      </div>
    </article>
  </main>

  <Footer lang={postLang} />
</Layout>

<!-- Prose styling lives in global.css. This page used to carry a scoped copy,
     which drifted out of sync with it — the list-marker bug had to be fixed in
     both places before they were merged. Don't reintroduce one. -->
