---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Hero from "../../components/Hero.astro";
import Features from "../../components/Features.astro";
import CreatorNote from "../../components/CreatorNote.astro";
import BlogPreview from "../../components/BlogPreview.astro";
import FAQ from "../../components/FAQ.astro";
import ClosingCTA from "../../components/ClosingCTA.astro";
import Footer from "../../components/Footer.astro";

const lang = "it";
---

<Layout
  title="Dear Wander: tempo schermo consapevole su iPhone"
  description="Sessanta secondi per tornare a te. Dear Wander accoglie il tuo scroll con una respirazione guidata prima di aprire i social. Gratis su iPhone, senza account."
>
  <Header lang={lang} />
  <main>
    <Hero lang={lang} />
    <Features lang={lang} />
    <CreatorNote lang={lang} />
    <BlogPreview lang={lang} />
    <FAQ lang={lang} />
    <ClosingCTA lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
